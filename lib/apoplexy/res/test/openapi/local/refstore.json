{
  "openapi": "3.0.3",
  "info": { "title": "Refstore", "version": "1.0.0" },
  "servers": [
    { "url": "/v{version}", "variables": { "version": { "default": "2", "enum": ["1", "2"] } } }
  ],
  "security": [{ "queryKey": [] }],
  "paths": {
    "/items": {
      "parameters": [{ "$ref": "#/components/parameters/requestId" }],
      "get": {
        "operationId": "listItems",
        "security": [],
        "parameters": [{ "$ref": "#/components/parameters/limit" }],
        "responses": {
          "200": {
            "description": "items",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Item" } }
              }
            }
          }
        }
      },
      "head": {
        "operationId": "probeItems",
        "responses": { "200": { "description": "ok" } }
      },
      "post": {
        "operationId": "createItem",
        "requestBody": { "$ref": "#/components/requestBodies/NewItem" },
        "responses": {
          "202": { "description": "queued" },
          "201": { "$ref": "#/components/responses/Item" }
        }
      }
    },
    "/items/{itemId}": {
      "parameters": [
        { "name": "itemId", "in": "path", "required": true,
          "schema": { "type": "integer", "format": "int64" } }
      ],
      "get": {
        "operationId": "getItem",
        "responses": {
          "200": { "$ref": "#/components/responses/Item" },
          "404": { "$ref": "#/components/responses/Missing" },
          "default": {
            "description": "a problem",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          }
        }
      }
    },
    "/items/{itemId}/label": {
      "parameters": [
        { "name": "itemId", "in": "path", "required": true,
          "schema": { "type": "integer", "format": "int64" } }
      ],
      "get": {
        "operationId": "getLabel",
        "responses": {
          "200": {
            "description": "the label",
            "content": { "text/plain": { "schema": { "type": "string" } } }
          }
        }
      }
    },
    "/items/{itemId}/icon": {
      "parameters": [
        { "name": "itemId", "in": "path", "required": true,
          "schema": { "type": "integer", "format": "int64" } }
      ],
      "get": {
        "operationId": "getIcon",
        "responses": {
          "200": {
            "description": "the icon",
            "content": { "image/png": { "schema": { "type": "string", "format": "binary" } } }
          }
        }
      }
    },
    "/items/{itemId}/notes": {
      "parameters": [
        { "name": "itemId", "in": "path", "required": true,
          "schema": { "type": "integer", "format": "int64" } }
      ],
      "get": {
        "operationId": "getNotes",
        "security": [{ "cookieKey": [] }],
        "responses": {
          "200": {
            "description": "the notes",
            "content": { "application/yaml": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/items/{itemId}/attachments": {
      "parameters": [
        { "name": "itemId", "in": "path", "required": true,
          "schema": { "type": "integer", "format": "int64" } }
      ],
      "post": {
        "operationId": "attach",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": { "type": "object", "properties": { "file": { "type": "string", "format": "binary" } } }
            }
          }
        },
        "responses": {
          "201": {
            "description": "attached",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Item" } } }
          }
        }
      }
    },
    "/items/{itemId}/bundle": {
      "parameters": [
        { "name": "itemId", "in": "path", "required": true,
          "schema": { "type": "integer", "format": "int64" } }
      ],
      "get": {
        "operationId": "bundle",
        "responses": {
          "200": {
            "description": "the item's files",
            "content": { "multipart/mixed": { "schema": { "type": "string", "format": "binary" } } }
          }
        }
      }
    },
    "/items/{itemId}/archive": {
      "parameters": [
        { "name": "itemId", "in": "path", "required": true,
          "schema": { "type": "integer", "format": "int64" } }
      ],
      "get": {
        "operationId": "getArchive",
        "responses": {
          "200": {
            "description": "the item's files, zipped",
            "content": { "application/zip": { "schema": { "type": "string", "format": "binary" } } }
          }
        }
      }
    },
    "/items/{itemId}/backup": {
      "parameters": [
        { "name": "itemId", "in": "path", "required": true,
          "schema": { "type": "integer", "format": "int64" } }
      ],
      "get": {
        "operationId": "getBackup",
        "responses": {
          "200": {
            "description": "the item's files, as a tarball",
            "content": { "application/x-tar": { "schema": { "type": "string", "format": "binary" } } }
          }
        }
      }
    },
    "/items/{itemId}/manual": {
      "parameters": [
        { "name": "itemId", "in": "path", "required": true,
          "schema": { "type": "integer", "format": "int64" } }
      ],
      "get": {
        "operationId": "getManual",
        "responses": {
          "200": {
            "description": "the item's manual",
            "content": { "application/pdf": { "schema": { "type": "string", "format": "binary" } } }
          }
        }
      }
    },
    "/items/{itemId}/certificate": {
      "parameters": [
        { "name": "itemId", "in": "path", "required": true,
          "schema": { "type": "integer", "format": "int64" } }
      ],
      "get": {
        "operationId": "getCertificate",
        "responses": {
          "200": {
            "description": "the item's certificate, PEM-armored",
            "content": { "application/x-pem-file": { "schema": { "type": "string", "format": "binary" } } }
          }
        }
      }
    },
    "/lookup": {
      "post": {
        "operationId": "lookup",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": { "type": "object", "properties": { "q": { "type": "string" } } }
            }
          }
        },
        "responses": {
          "200": {
            "description": "matches",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Item" } }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" }
        }
      },
      "NewItem": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string" } }
      },
      "Problem": {
        "type": "object",
        "required": ["message"],
        "properties": { "message": { "type": "string" } }
      }
    },
    "parameters": {
      "limit": { "name": "limit", "in": "query", "schema": { "type": "integer" } },
      "requestId": {
        "name": "X-Request-Id", "in": "header", "required": true, "schema": { "type": "string" }
      }
    },
    "responses": {
      "Missing": {
        "description": "no such item",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Item": {
        "description": "an item",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Item" } } }
      }
    },
    "securitySchemes": {
      "queryKey": { "type": "apiKey", "name": "token", "in": "query" },
      "cookieKey": { "type": "apiKey", "name": "session", "in": "cookie" }
    },
    "requestBodies": {
      "NewItem": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NewItem" } } }
      }
    }
  }
}
