-   handle.write(data)
+   handle.write(data)

- recover:
+ recover:

-   case error: Io.Error => fallback
+   case error: Io.Error => fallback

- . protect(readConfiguration())           // a handler, for this block
+ . protect(readConfiguration())           // a handler, for this block

- supervise:                               // a supervisor, for this block
+ supervise:                               // a supervisor, for this block

