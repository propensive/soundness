+   case Attempt.Failure(Api.NotFound(()))           => t"no such pet"

-   case Attempt.Failure(Api.BadRequest(()))         => t"bad id"
+   case Attempt.Failure(Api.BadRequest(()))         => t"bad id"

- given basic: ("basicAuth" is Credential to Auth) = Credential(Auth.Basic(t"user", t"pass"))
