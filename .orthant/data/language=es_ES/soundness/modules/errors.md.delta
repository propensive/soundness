+ Out.println(safely(connect(8080)).inspect)

- Out.println(safely(connect(80)).inspect)
+ Out.println(safely(connect(80)).inspect)

- Out.println(capture[PortError](connect(80)).port.show)
+ Out.println(capture[PortError](connect(80)).port.show)

