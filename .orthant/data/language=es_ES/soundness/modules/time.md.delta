+ ```scala

- val built = Timestamp(2023-May-28, Clockface(14, 30, 59))
+ val built = Timestamp(2023-May-28, Clockface(14, 30, 59))

- val decoded = t"2024-01-15T14:30:59".as[Timestamp]
+ val decoded = t"2024-01-15T14:30:59".as[Timestamp]

- val written = ts"2023-05-28T14:30:59"
+ val written = ts"2023-05-28T14:30:59"

= val written = ts"2023-05-28T14:30:59"
- ```
