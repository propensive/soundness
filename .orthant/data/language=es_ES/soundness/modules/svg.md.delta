+ ```scala

- val line = Polyline(List(Point(0, 60), Point(50, 20), Point(100, 40)))
+ val line = Polyline(List(Point(0, 60), Point(50, 20), Point(100, 40)))

- val area = Polyline(List(Point(0, 60), Point(50, 20), Point(100, 40), Point(100, 60)), closed = true)
+ val area = Polyline(List(Point(0, 60), Point(50, 20), Point(100, 40), Point(100, 60)), closed = true)

= val area = Polyline(List(Point(0, 60), Point(50, 20), Point(100, 40), Point(100, 60)), closed = true)
