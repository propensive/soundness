+ val validity = Instant(1_700_000_000_000L) ~ Instant(1_900_000_000_000L)

- val certificate =
+ val certificate =

-   Certificate.selfSigned(subject, privateKey, validity, BigInt(1), alternatives = List(t"example.com"))
+   Certificate.selfSigned(subject, privateKey, validity, BigInt(1), alternatives = List(t"example.com"))

=   Certificate.selfSigned(subject, privateKey, validity, BigInt(1), alternatives = List(t"example.com"))
