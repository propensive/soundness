+ val root = Certificate.selfSigned(identity, swarmKey, validity, BigInt(1), authority = true)

- val leaf =
+ val leaf =

-   Certificate.issued(subject, tlsKey.public, identity, swarmKey, validity, BigInt(2), alternatives = List(t"example.com"))
