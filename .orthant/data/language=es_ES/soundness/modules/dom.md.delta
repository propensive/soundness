- Out.println(Javascript.serialize(focused.expr))
+ Out.println(Javascript.serialize(focused.expr))

- Out.println(Javascript.serialize(first.click().expr))
+ Out.println(Javascript.serialize(first.click().expr))

- Out.println(Javascript.serialize(scrolled.expr))
+ Out.println(Javascript.serialize(scrolled.expr))

= Out.println(Javascript.serialize(scrolled.expr))
