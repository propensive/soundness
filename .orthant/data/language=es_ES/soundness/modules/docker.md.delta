+ def entry(name: Text, content: Text): Tar.Entry =

-   Tar.Entry.File
+   Tar.Entry.File

-    ( path  = name.as[Relative on Tar],
+    ( path  = name.as[Relative on Tar],

-      mode  = UnixMode(),
+      mode  = UnixMode(),

-      user  = UnixUser(0),
+      user  = UnixUser(0),

-      group = UnixGroup(0),
+      group = UnixGroup(0),

-      mtime = 0.bits.u32,
+      mtime = 0.bits.u32,

-      data  = Archive.Body(content.in[Data]) )
+      data  = Archive.Body(content.in[Data]) )

- val layer = Oci.Layer(Tarfile(List(entry(t"hello.txt", t"hello world\n"))))
