- @primary()
+ @primary()

- case class Rgb(red: Int, green: Int, blue: Int) extends Colored
+ case class Rgb(red: Int, green: Int, blue: Int) extends Colored

= case class Rgb(red: Int, green: Int, blue: Int) extends Colored
