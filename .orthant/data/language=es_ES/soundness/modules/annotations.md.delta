- Out.println(fields.names(letters).inspect)
+ Out.println(fields.names(letters).inspect)

- Out.println(fields.select(letters, t"beta").inspect)
+ Out.println(fields.select(letters, t"beta").inspect)

- Out.println(fields.members(letters).inspect)
+ Out.println(fields.members(letters).inspect)

= Out.println(fields.members(letters).inspect)
