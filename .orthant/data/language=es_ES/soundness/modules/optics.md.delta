+ ##

- Out.println(play.lens(_.opening.scenes(Each).place = t"$prior!").opening.scenes.inspect)
+ Out.println(play.lens(_.opening.scenes(Each).place = t"$prior!").opening.scenes.inspect)

= Out.println(play.lens(_.opening.scenes(Each).place = t"$prior!").opening.scenes.inspect)
