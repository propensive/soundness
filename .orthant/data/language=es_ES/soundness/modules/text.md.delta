+ Out.println(lexicon.search(t"book", 0).inspect)

- Out.println(lexicon.search(t"booq", 1).inspect)
+ Out.println(lexicon.search(t"booq", 1).inspect)

= Out.println(lexicon.search(t"booq", 1).inspect)
