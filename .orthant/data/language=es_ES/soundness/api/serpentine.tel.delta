+       import soundness.*

-       Path(t"/", t"capulet", t"verona") == % / "verona" / "capulet"
+       Path(t"/", t"capulet", t"verona") == % / "verona" / "capulet"

=       Path(t"/", t"capulet", t"verona") == % / "verona" / "capulet"
