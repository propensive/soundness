+             var x = 0

-             var y = 0
+             var y = 0

-             reader.openObject()
+             reader.openObject()

-             var key = reader.key()
+             var key = reader.key()

-             while key.present do
+             while key.present do

-               key match
+               key match

-                 case t"x" => x = reader.int()
+                 case t"x" => x = reader.int()

-                 case t"y" => y = reader.int()
+                 case t"y" => y = reader.int()

-                 case _    => reader.skipValue()
+                 case _    => reader.skipValue()

-               key = reader.key()
+               key = reader.key()

