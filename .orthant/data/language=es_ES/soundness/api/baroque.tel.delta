-       import soundness.*
+       import soundness.*

-       val z: Complex[Int] = Complex(3, 4)
+       val z: Complex[Int] = Complex(3, 4)

-       z.real                         // 3
+       z.real                         // 3

-       z.imaginary                    // 4
+       z.imaginary                    // 4

-       z + Complex(1, -1)             // Complex(4, 3)
+       z + Complex(1, -1)             // Complex(4, 3)

-       z*Complex(2, 0)                // Complex(6, 8)
+       z*Complex(2, 0)                // Complex(6, 8)

-       -z                             // Complex(-3, -4)
+       -z                             // Complex(-3, -4)

-       ~z                             // Complex(3, -4), the conjugate
+       ~z                             // Complex(3, -4), the conjugate

-       val Complex(re, im) = z
+       val Complex(re, im) = z

=       val Complex(re, im) = z
-       ```
