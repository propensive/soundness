+       numbers.at(Sec)            // 20

-       numbers.at(Sept)           // Unset
+       numbers.at(Sept)           // Unset

-       ages.at(t"Hamlet")         // 30
+       ages.at(t"Hamlet")         // 30

-       ages.defines(t"Yorick")    // false
+       ages.defines(t"Yorick")    // false

=       ages.defines(t"Yorick")    // false
