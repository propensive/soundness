-       import soundness.*
+       import soundness.*

-       val letters = Sequence(t"a", t"b", t"c")   // Sequence[Text] & Populated
+       val letters = Sequence(t"a", t"b", t"c")   // Sequence[Text] & Populated

-       letters(Sec)                                // t"b"
+       letters(Sec)                                // t"b"

-       letters.head                                // t"a"
+       letters.head                                // t"a"

-       letters match
+       letters match

-         case Sequence(a, b, c) => a
+         case Sequence(a, b, c) => a

-         case _                 => t""
+         case _                 => t""

=         case _                 => t""
-       ```
+       ```

