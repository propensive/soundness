+         val closed = Atomic.Bool()

-         def close(): Unit = if !closed.ere(true) then ()   // runs the body once
+         def close(): Unit = if !closed.ere(true) then ()   // runs the body once

=         def close(): Unit = if !closed.ere(true) then ()   // runs the body once
