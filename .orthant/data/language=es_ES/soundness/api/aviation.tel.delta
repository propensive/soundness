+       summon[Hebdomad].start   // Sun

-       Weekday(Prim)            // Sun
+       Weekday(Prim)            // Sun

-       Sat.weekend              // true
+       Sat.weekend              // true

-       Mon.number               // Sec
+       Mon.number               // Sec

=       Mon.number               // Sec
-       ```
+       ```

