=       import soundness.*
=
-       val t0 = monotonic()
+       val t0 = monotonic()

-       ((t0 + 90*Second) - t0).value   // 90.0
+       ((t0 + 90*Second) - t0).value   // 90.0

=       ((t0 + 90*Second) - t0).value   // 90.0
-       (t0 + 1*Second).long - t0.long  // 1000000000
+       (t0 + 1*Second).long - t0.long  // 1000000000

=       ((t0 + 90*Second) - t0).value   // 90.0
=       (t0 + 1*Second).long - t0.long  // 1000000000
-       ```
+       ```

-       It is `Findable`, so a `MonotonicClock` of its own is bound as a local given to make a
-       timing deterministic.
+       Es `Findable`, así que un `MonotonicClock` propio se liga como given local para hacer
+       determinista una medición de tiempos.

