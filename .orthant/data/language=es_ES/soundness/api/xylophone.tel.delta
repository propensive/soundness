-           var x = 0
+           var x = 0

-           var y = 0
+           var y = 0

-           def loop(): Unit = reader.nextChild() match
+           def loop(): Unit = reader.nextChild() match

-             case Unset => ()
+             case Unset => ()

-             case name: Text =>
+             case name: Text =>

-               name.s match
+               name.s match

-                 case "x" => x = reader.int().or(0)
+                 case "x" => x = reader.int().or(0)

-                 case "y" => y = reader.int().or(0)
+                 case "y" => y = reader.int().or(0)

-                 case _   => reader.skipElement()
+                 case _   => reader.skipElement()

-               loop()
+               loop()

-           loop()
+           loop()

-           Point(x, y)
+           Point(x, y)

=           Point(x, y)
