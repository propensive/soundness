+ ##

- '{
+ '{

-     import htmlDoms.whatwg
+     import htmlDoms.whatwg

-     unsafely(honeycomb.Benchmarks.html1.load[Html])
+     unsafely(honeycomb.Benchmarks.html1.load[Html])

- }
