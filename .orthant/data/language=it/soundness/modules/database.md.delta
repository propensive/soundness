- shelf.unassign(box)
+ shelf.unassign(box)

= shelf.unassign(box)
- Out.println(shelf.lookup[Box].map(_()).inspect)
+ Out.println(shelf.lookup[Box].map(_()).inspect)

= Out.println(shelf.lookup[Box].map(_()).inspect)
