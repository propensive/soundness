+ ##

- Out.println(Srgb(0.2, 0.4, 0.6).mix(Srgb(0.8, 0.6, 0.4)).inspect)
+ Out.println(Srgb(0.2, 0.4, 0.6).mix(Srgb(0.8, 0.6, 0.4)).inspect)

- Out.println(WebColors.Ivory.to[Cielab].mix(WebColors.DeepPink.to[Cielab]).to[Srgb].inspect)
