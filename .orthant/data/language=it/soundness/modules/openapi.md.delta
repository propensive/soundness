- val one: Pet = api.pets(42).get.call[Pet]()
+ val one: Pet = api.pets(42).get.call[Pet]()

- val some: List[Pet] = api.pets.get(limit = 10).call[List[Pet]]()
+ val some: List[Pet] = api.pets.get(limit = 10).call[List[Pet]]()

- val created: Pet = api.pets.post(NewPet(t"Crab")).call[Pet]()
+ val created: Pet = api.pets.post(NewPet(t"Crab")).call[Pet]()

- val deleted: Unit = api.sessions(t"abc").delete.call()
+ val deleted: Unit = api.sessions(t"abc").delete.call()

= val deleted: Unit = api.sessions(t"abc").delete.call()
