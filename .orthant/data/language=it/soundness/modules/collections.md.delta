- Out.println(numbers.fold(0)(_ + _).show)
+ Out.println(numbers.fold(0)(_ + _).show)

- Out.println(numbers.trace(0)(_ + _).inspect)
+ Out.println(numbers.trace(0)(_ + _).inspect)

= Out.println(numbers.trace(0)(_ + _).inspect)
