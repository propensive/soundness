- ##
+ ##

- Out.println(naturals.keep(5).to[List].inspect)
+ Out.println(naturals.keep(5).to[List].inspect)

- Out.println(naturals.skip(10).keep(2).to[List].inspect)
+ Out.println(naturals.skip(10).keep(2).to[List].inspect)

- Out.println(Chain.continually(7).keep(3).to[List].inspect)
