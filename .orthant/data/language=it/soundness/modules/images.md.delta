+ val jpegBytes = image.to[Jpeg].read[Data]

- val webpBytes = image.to[Webp].read[Data]
+ val webpBytes = image.to[Webp].read[Data]

- Out.println(webpBytes.read[Raster in Webp](1, 0).blue.show)
