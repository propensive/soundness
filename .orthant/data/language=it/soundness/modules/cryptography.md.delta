+ ```scala

- import signatureDigests.sha256Signature
+ import signatureDigests.sha256Signature

- val document = t"an important document"
+ val document = t"an important document"

- val signer = PrivateKey.generate[Ecdsa[256]]()
+ val signer = PrivateKey.generate[Ecdsa[256]]()

- val signature = signer.sign(document)
+ val signature = signer.sign(document)

= val signature = signer.sign(document)
- ```
