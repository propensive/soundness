+ ```scala

- val gregorian = { import calendars.gregorianCalendar; (1900-Mar-10).jdn }
+ val gregorian = { import calendars.gregorianCalendar; (1900-Mar-10).jdn }

- val julian = { import calendars.julianCalendar; (1900-Mar-10).jdn }
+ val julian = { import calendars.julianCalendar; (1900-Mar-10).jdn }

= val julian = { import calendars.julianCalendar; (1900-Mar-10).jdn }
- ```
+ ```

