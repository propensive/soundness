+ hello.entries.each(entry => Out.println(entry.ref.encode))

- Out.println(hello.entry(t"hello.txt".as[Path on Zip]).read[Text])
+ Out.println(hello.entry(t"hello.txt".as[Path on Zip]).read[Text])

