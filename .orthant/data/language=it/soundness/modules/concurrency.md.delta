+ ```scala

- val interrupted = supervise:
+ val interrupted = supervise:

= val interrupted = supervise:
-   val task = async:
+   val task = async:

-     snooze(10.0*Second)
+     snooze(10.0*Second)

-     expensiveComputation()
+     expensiveComputation()

=     expensiveComputation()
=
-   task.cancel()
+   task.cancel()

-   t"canceled without waiting ten seconds"
+   t"canceled without waiting ten seconds"

=   t"canceled without waiting ten seconds"
- ```
