+ val promised = supervise:

-   val promise = Promise[Int]()
+   val promise = Promise[Int]()

-   daemon(promise.fulfill(7))
+   daemon(promise.fulfill(7))

-   promise.await()
+   promise.await()

=   promise.await()
- ```
+ ```

=   promise.await()
= ```
