-   code
+   code

-       Person(t"Hamlet", 30).in[Text over Xml]
+       Person(t"Hamlet", 30).in[Text over Xml]

- alternative Direct
+ alternative Direct

= alternative Direct
-   code
+   code

-       val direct =
+       val direct =

-         given Person is Xml.Printable = Xml.Direct.derived[Person].printable
+         given Person is Xml.Printable = Xml.Direct.derived[Person].printable

-         Person(t"Hamlet", 30).in[Text over Xml]
+         Person(t"Hamlet", 30).in[Text over Xml]

=         Person(t"Hamlet", 30).in[Text over Xml]
- ##
