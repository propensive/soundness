+ ```scala

- val prefixed = t"""<r xmlns:a="urn:a"><a:x>1</a:x></r>""".read[Xml]
+ val prefixed = t"""<r xmlns:a="urn:a"><a:x>1</a:x></r>""".read[Xml]

- val element = prefixed.`a:x`() match
+ val element = prefixed.`a:x`() match

-   case Xml.Fragment(element: Xml.Element) => element
+   case Xml.Fragment(element: Xml.Element) => element

=   case Xml.Fragment(element: Xml.Element) => element
