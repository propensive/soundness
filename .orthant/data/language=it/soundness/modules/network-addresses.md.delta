- val ipv4 = ip"192.168.0.1"
+ val ipv4 = ip"192.168.0.1"

- val ipv6 = ip"2001:db8::1"
+ val ipv6 = ip"2001:db8::1"

= val ipv6 = ip"2001:db8::1"
