=         t"日本".metrics   // 2
=
-       locally:
+       locally:

-         import textMetrics.eastAsianScriptsMetric
+         import textMetrics.eastAsianScriptsMetric

-         t"日本".metrics   // 4
+         t"日本".metrics   // 4

=         t"日本".metrics   // 4
