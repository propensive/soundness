=
-     t"/home/work/docs" match
+     t"/home/work/docs" match

-       case g"/$home/$work/docs" => (home, work)   // (t"home", t"work")
+       case g"/$home/$work/docs" => (home, work)   // (t"home", t"work")

-       case _                    => (t"", t"")
+       case _                    => (t"", t"")

=       case _                    => (t"", t"")
=
-     t"/home/work/docs" match
+     t"/home/work/docs" match

-       case g"/$home/**" => home   // t"home"
+       case g"/$home/**" => home   // t"home"

-       case _            => t""
+       case _            => t""

-     t"file.txt" match
+     t"file.txt" match

-       case g"*.txt" => true
+       case g"*.txt" => true

-       case _        => false
+       case _        => false

=       case _        => false
-     ```
