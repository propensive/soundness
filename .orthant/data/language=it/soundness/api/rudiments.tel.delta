+     import sortingAlgorithms.timsort

-     List(t"ccc", t"a", t"bb").order(_.length)   // List(t"a", t"bb", t"ccc")
+     List(t"ccc", t"a", t"bb").order(_.length)   // List(t"a", t"bb", t"ccc")

-     List(3, 1, 2).order(-_)                      // List(3, 2, 1)
+     List(3, 1, 2).order(-_)                      // List(3, 2, 1)

=     List(3, 1, 2).order(-_)                      // List(3, 2, 1)
