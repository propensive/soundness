=
=       ```scala
-       import soundness.*
+       import soundness.*

-       Exit(0)              // Exit.Ok
+       Exit(0)              // Exit.Ok

-       Exit(2)              // Exit.Fail(2)
+       Exit(2)              // Exit.Fail(2)

-       Exit.Fail(2)()       // 2
+       Exit.Fail(2)()       // 2

=       Exit.Fail(2)()       // 2
-       ```
+       ```

