-       import soundness.*
+       import soundness.*

-       List(1, 2, 3).has(2)       // true
+       List(1, 2, 3).has(2)       // true

-       Set(t"a", t"b").has(t"c")  // false
+       Set(t"a", t"b").has(t"c")  // false

-       t"hello".has('e')          // true
+       t"hello".has('e')          // true

=       t"hello".has('e')          // true
-       ```
+       ```

