-     import soundness.*
+     import soundness.*

=     an index proven against both.
=
=     ```scala
=     import soundness.*
=
-     val left = Array(1, 2, 3)
+     val left = Array(1, 2, 3)

=     an index proven against both.
=
=     ```scala
=     import soundness.*
=
=     val left = Array(1, 2, 3)
-     val right = Array(10, 20, 30)
+     val right = Array(10, 20, 30)

=     an index proven against both.
=
