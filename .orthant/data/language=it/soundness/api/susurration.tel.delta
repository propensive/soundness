+       writer.byte(Ssh.Message.ServiceRequest)

-       writer.text(t"ssh-userauth")
+       writer.text(t"ssh-userauth")

-       writer.names(List(t"curve25519-sha256", t"ecdh-sha2-nistp256"))
+       writer.names(List(t"curve25519-sha256", t"ecdh-sha2-nistp256"))

-       writer.mpint(BigInt("123456789012345678901234567890"))
+       writer.mpint(BigInt("123456789012345678901234567890"))

-       val reader = Wire.Reader(writer.data)
+       val reader = Wire.Reader(writer.data)

-       reader.byte()      // 5
+       reader.byte()      // 5

-       reader.text()      // t"ssh-userauth"
+       reader.text()      // t"ssh-userauth"

-       reader.names()     // List(t"curve25519-sha256", t"ecdh-sha2-nistp256")
+       reader.names()     // List(t"curve25519-sha256", t"ecdh-sha2-nistp256")

-       reader.mpint()     // BigInt("123456789012345678901234567890")
+       reader.mpint()     // BigInt("123456789012345678901234567890")

-       reader.end()
+       reader.end()

=       reader.end()
