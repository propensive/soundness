-         import soundness.*
+         import soundness.*

-         Tui.Magnitude.interval(161.0)          // t"2m41s"
+         Tui.Magnitude.interval(161.0)          // t"2m41s"

-         Tui.Magnitude.count(1200L)             // t"1.2k"
+         Tui.Magnitude.count(1200L)             // t"1.2k"

-         Tui.Magnitude.percentage(Tui.Fraction(0.07))   // t"  7%"
+         Tui.Magnitude.percentage(Tui.Fraction(0.07))   // t"  7%"

-         Tui.Magnitude.bytes(4200000.0, true)   // t"4.00 MiB"
+         Tui.Magnitude.bytes(4200000.0, true)   // t"4.00 MiB"

-         Tui.Magnitude.rate(1500.0, false)      // t"1.50 kB/s"
+         Tui.Magnitude.rate(1500.0, false)      // t"1.50 kB/s"

=         Tui.Magnitude.rate(1500.0, false)      // t"1.50 kB/s"
