+     j"""[1, 2, 3, 4]""" match

-       case j"""[$head, $tail*]""" => (head, tail)
+       case j"""[$head, $tail*]""" => (head, tail)

-       case _                      => (j"0", j"[]")
+       case _                      => (j"0", j"[]")

