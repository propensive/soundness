-           "required": ["name", "children"],
+           "required": ["name", "children"],

-           "properties": {
+           "properties": {

-             "name": { "type": "string" },
+             "name": { "type": "string" },

-             "email": { "type": "string", "format": "email" },
+             "email": { "type": "string", "format": "email" },

-             "children": {
+             "children": {

-               "type": "array",
+               "type": "array",

