+         import soundness.*

-         case class Point(x: Int, y: Int)
+         case class Point(x: Int, y: Int)

-         object Point:
+         object Point:

-           given Point is Json.Parsable = Json.Parsable(Morphology.Any): reader =>
+           given Point is Json.Parsable = Json.Parsable(Morphology.Any): reader =>

-             var x = 0
+             var x = 0

-             var y = 0
+             var y = 0

-             reader.openObject()
+             reader.openObject()

-             var key = reader.key()
+             var key = reader.key()

-             while key.present do
+             while key.present do

-               key match
+               key match

-                 case t"x" => x = reader.int()
+                 case t"x" => x = reader.int()

-                 case t"y" => y = reader.int()
+                 case t"y" => y = reader.int()

-                 case _    => reader.skipValue()
+                 case _    => reader.skipValue()

-               key = reader.key()
+               key = reader.key()

-             Point(x, y)
+             Point(x, y)

=             Point(x, y)
