=     ```scala
-     import soundness.*
+     import soundness.*

-     Text.build:
+     Text.build:

-       append(t"x = ")
+       append(t"x = ")

-       append(42)
+       append(42)

-       append('!')
+       append('!')

-     // t"x = 42!"
+     // t"x = 42!"

=     // t"x = 42!"
-     ```
