-     rgba.pixel(0, 2).alpha   // 255
+     rgba.pixel(0, 2).alpha   // 255

-     val packed = Raster(1, 1)((x, y) => Chroma(255, 0, 51)).repack[(Channel.Red[5], Channel.Green[6], Channel.Blue[5])]
+     val packed = Raster(1, 1)((x, y) => Chroma(255, 0, 51)).repack[(Channel.Red[5], Channel.Green[6], Channel.Blue[5])]

-     packed.pixel(0, 0).red   // 31
+     packed.pixel(0, 0).red   // 31

-     packed.pixel(0, 0).blue  // 6
+     packed.pixel(0, 0).blue  // 6

=     packed.pixel(0, 0).blue  // 6
