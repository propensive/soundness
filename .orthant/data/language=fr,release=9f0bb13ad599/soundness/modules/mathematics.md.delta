+ ```scala

- val v: Vector[Int, 3] = Vector(1, 2, 3)
+ val v: Vector[Int, 3] = Vector(1, 2, 3)

= val v: Vector[Int, 3] = Vector(1, 2, 3)
- ```
+ ```

