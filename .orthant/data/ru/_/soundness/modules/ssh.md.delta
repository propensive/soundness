% 0 1 0 071305ceb5c1200814dd80cde084cad8

% 0 1 0 07114e66baf1ba621e2178e968725f7d

% 1 1 0 15bc84f7aefa7ee8131a8362fc51e794

% 3 1 0 13719fc01c5162fc0bc91f558ac89205

% 4 1 0 0f2eb127c175d4350761c228b57effc6

% 5 1 0 08498ba588f118f9013063bff2a29fcf

% 0 1 0 1b515121ebac80ed1c4a2528e885e8db

