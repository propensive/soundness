% 7 1 0 1e33f7ad12cd527a1b91bb699732582b

% 0 1 0 1cc4f93273b759961610bef56f39dc95

% 1 1 0 1f1fb43e54e0ba7f012801bd7cf99ca9

@ 0 1 0 0b353a7f269d6fae15695d4b2731dc3e
+   label Отсутствующий столбец принимает значение поля по умолчанию

% 1 1 0 05678e5a5a6211a313b76a6591654c48

