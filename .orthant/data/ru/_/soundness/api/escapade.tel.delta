% 0 1 0 11287874a7c3dd1702a9ec3c43983c30

% 0 1 0 14bbcdc629f9f0780a83ef1dfce8b95a

% 0 1 0 17592cf3cd4625210e1d54c62aa22040

% 1 1 0 0a0a2ed3f662272d1cd3ec8a31b246d6

