@ 0 103 0 1f1326be7d1c5278167ad8f3c851cc2b
+   entry #alias   `alias` (выводит или определяет псевдонимы оболочки) выполняется как `Text`: весь её вывод, когда она завершится
+   entry #ar   `ar` (сопровождает библиотеки-архивы) выполняется как `Text`: весь её вывод, когда она завершится
+   entry #at   `at` (ставит команду в очередь на выполнение позже) выполняется как `Text`: весь её вывод, когда она завершится
+   entry #awk   `awk` (язык поиска и обработки по образцам) выполняется как `Text`: весь её вывод, когда она завершится
+   entry #basename   `basename` (сокращает путь до последнего сегмента) выполняется как `Text`: весь её вывод, когда она завершится
+   entry #batch   `batch` (ставит команду в очередь на выполнение, когда позволит нагрузка) выполняется как `Text`: весь её вывод, когда она завершится
+   entry #bc   `bc` (калькулятор произвольной точности) выполняется как `Text`: весь её вывод, когда она завершится
+   entry #cat   `cat` (конкатенирует файлы) выполняется как `Chain[Text]`: её строки, лениво
+   entry #chgrp   `chgrp` (меняет группу файла) выполняется как `Exit`: её результат — её код завершения
+   entry #chmod   `chmod` (меняет режим файла) выполняется как `Exit`: её результат — её код завершения
+   entry #chown   `chown` (меняет владельца файла) выполняется как `Exit`: её результат — её код завершения
+   entry #cksum   `cksum` (контрольная сумма CRC и размер файла) выполняется как `Text`: весь её вывод, когда она завершится
+   entry #cmp   `cmp` (сравнивает два файла побайтно) выполняется как `Text`: весь её вывод, когда она завершится
+   entry #comm   `comm` (строки, общие или не общие для двух отсортированных файлов) выполняется как `Text`: весь её вывод, когда она завершится
+   entry #command   `command` (выполняет команду в обход функций оболочки) выполняется как `Text`: весь её вывод, когда она завершится
+   entry #cp   `cp` (копирует файлы) выполняется как `Exit`: её результат — её код завершения
+   entry #crontab   `crontab` (редактирует таблицу cron) выполняется как `Text`: весь её вывод, когда она завершится
+   entry #csplit   `csplit` (разбивает файл по контексту) выполняется как `Text`: весь её вывод, когда она завершится
+   entry #cut   `cut` (выбирает столбцы каждой строки) выполняется как `Text`: весь её вывод, когда она завершится
+   entry #date   `date` (выводит или устанавливает дату) выполняется как `Text`: весь её вывод, когда она завершится
+   entry #dd   `dd` (копирует и преобразует блоки) выполняется как `Text`: весь её вывод, когда она завершится
+   entry #df   `df` (свободное место на диске) выполняется как `Text`: весь её вывод, когда она завершится
+   entry #diff   `diff` (различия между двумя файлами) выполняется как `Text`: весь её вывод, когда она завершится
