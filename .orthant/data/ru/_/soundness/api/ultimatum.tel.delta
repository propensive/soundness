@ 0 9 0 029daa69c000bc5d038eb3935f75b9dd
+     entry #contents   текущие дочерние панели по порядку, в виде `Sequence`
+     entry #size   число дочерних панелей
+     entry #apply   дочерняя панель по индексу, начиная с нуля
+     entry #append   добавляет панель в конец
+     entry #prepend   добавляет панель в начало
+     entry #insert   вставляет панель в позицию, ограниченную пределами контейнера
+     entry #insertBefore   вставляет панель непосредственно перед опорной панелью, по идентичности; добавляет в конец, если её нет
+     entry #insertAfter   вставляет панель непосредственно после опорной панели, по идентичности; добавляет в конец, если её нет
+     entry #remove   удаляет панель, по идентичности, если она есть

