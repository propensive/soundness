@ 0 8 0 1553f8c8c8c7cc080c8cf62d5f0bca91
+ column  Компонент
+ column  Строк
+ column  Примечания
+ row  десериализатор деревьев в простые данные  ~2,000  `hyperbole.tasty` даёт заголовок и таблицу имён
