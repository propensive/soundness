+   map(t"Gloucester") = 60

- Out.println(court.at(t"Kent").inspect)
+ Out.println(court.at(t"Kent").inspect)

- Out.println((court == ages.define(t"Gloucester", 60)).inspect)
+ Out.println((court == ages.define(t"Gloucester", 60)).inspect)

