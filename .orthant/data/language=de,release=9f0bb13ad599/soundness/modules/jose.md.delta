- Out.println(sealedLine.header.algorithm.or(t"none"))
+ Out.println(sealedLine.header.algorithm.or(t"none"))

- Out.println(sealedLine.header.encryption.or(t"none"))
+ Out.println(sealedLine.header.encryption.or(t"none"))

- Out.println(opened)
+ Out.println(opened)

= Out.println(opened)
- ```
+ ```

