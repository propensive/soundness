+     val options: Json = WebAuthn.registration(globe, burbage, challenge)

-     def enrol(answer: Json): WebAuthn.Credential = WebAuthn.register(answer, challenge, globe)
+     def enrol(answer: Json): WebAuthn.Credential = WebAuthn.register(answer, challenge, globe)

