+   entry #name      il nome con cui si invia la selezione
+   entry #options   le opzioni, ciascuna una chiave inviata e un'etichetta mostrata
+   entry #value     la chiave attualmente selezionata

@ 0 1 0 10bbf692c1710aac101133d3b4ede78c
