% 0 1 0 1a0956e12c4e8ea001219f8da9570ea6

% 1 1 0 02094e092bf4544e155758d141bb3d78

% 2 1 0 1e121ec0cee180f01aa88a17e9cdd1b8

% 0 1 0 152056ea1fe75f4106f76310332e5454

% 1 1 0 150769687e4adbb2138be066a9958a5a

% 1 1 0 021bb4adcca8565817503ee1d3e79ddb

