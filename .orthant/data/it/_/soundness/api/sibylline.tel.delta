% 0 1 0 0bcb7b86128ad1e20a0d6aeb1df414db

% 0 1 0 0fb6d9247ae4f10f0ec6801fbc0f9374

% 0 1 0 0dbfb9029a13416308198755f434997e

% 0 1 0 0d6d162b292059b50991ab806e1822d8

