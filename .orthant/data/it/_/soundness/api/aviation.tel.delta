% 0 1 0 1771d26ba1a5af1e0bedb809097587f4

% 0 1 0 194c5cf653e5b575144fd916a7113aa0

% 0 1 0 096630bfbab880b51b1b94b80be5fac0

% 0 1 0 129b1a97b0c948a201b19c7a8bfe79da

% 1 1 0 1070c0bb43223f430cf99f21c7472ef8

