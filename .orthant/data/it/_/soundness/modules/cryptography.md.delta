% 0 1 0 1218a0ec339d4be513372b978ae2f193

% 0 1 0 09a983d270293fa50e81eca40cc1fb84

% 1 1 0 13c21cedabbcacf504c94b12632a5a9d

% 3 1 0 0261cc9f72ed63b31e5ca974514c89b4

% 4 1 0 0fa7e8bc5e2ba907076beaeb14dade68

% 5 1 0 0af6182b52e7cdbb1208f085a85051fb

