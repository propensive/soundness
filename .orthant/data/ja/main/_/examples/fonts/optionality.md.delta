% 2 1 0 052b5d53c564213f191f74be413a911f

% 0 1 0 1d6c44d228adb5861e90e8b4b114134c

% 1 1 0 010d60e7c12f7dd00a63fbb2e2afd803

@ 0 2 0 076e07d245251dfa0348f39b3fc0c389
+   label 名前、あるいはそれがないことを表す語
+   highlight or(t"untitled")  ここで不在が意味するもの

% 1 1 0 07567102a61500150b6466752b5fce67

