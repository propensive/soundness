@ 0 15 0 13f5918790b8d53811a75f3e81719770
+     entry #length   それまでに書いたバイト数
+     entry #byte   一バイト
+     entry #boolean   一バイト：`true` なら `1`、`false` なら `0`
+     entry #uint32   ビッグエンディアンの 32 ビット整数
+     entry #uint64   ビッグエンディアンの 64 ビット整数
+     entry #string   `uint32` の長さと、そのバイト列
+     entry #bytes   長さの接頭辞のないバイト列：固定長のフィールド、またはすでにエンコードしたメッセージ
+         `Session` はこれでコマンドの出力のチャンクをつなぎ、トランスポートはこれで一つのメッセージを別のメッセージ（署名付きの認証リクエスト）に埋め込む。
+     entry #text   長さを前置した、UTF-8 のテキスト
+     entry #mpint   最短の 2 の補数の形の `BigInt`。長さを前置し、ゼロは空の文字列になる
+         RFC 4251 が定めるとおり、最上位ビットが立った正の数には先頭にゼロのバイトが付き（`0x80` は `00 80` にエンコードされる）、負の数はその 2 の補数になる。
+     entry #names   カンマでつないだ名前のリスト。長さを前置したテキストとして
+     entry #data   それまでに書いたすべてを、新しい `Data` として
