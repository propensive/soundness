@ 0 25 0 0af5d7232768e72d03175cc37e6dcdc8
+   entry .apply   `Typeface["Inter"]`: krój pisma rodziny, z jej nazwy jako typu literałowego
+       Metoda inline, której argumentem typu jest nazwa rodziny, jako `Label`: nazwa jest
+       odczytywana z typu przez `constValue`, więc musi być literałem. Wynikiem jest
+       `Typeface of family`, z nazwą zarówno jako wartością, jak i typem.
+   entry .SansSerif   ogólna rodzina CSS `sans-serif`, `Typeface of "sans-serif"`
+   entry .Serif   ogólna rodzina CSS `serif`, `Typeface of "serif"`
+   entry .Monospace   ogólna rodzina CSS `monospace`, `Typeface of "monospace"`
+   entry .Cursive   ogólna rodzina CSS `cursive`, `Typeface of "cursive"`
+   entry .Fantasy   ogólna rodzina CSS `fantasy`, `Typeface of "fantasy"`
+   entry .SystemUi   ogólna rodzina CSS `system-ui`, `Typeface of "system-ui"`
+   entry .showable   pokazuje krój pisma jako nazwę jego rodziny
+   entry .inspectable   jest inspekcjonowany jako `Typeface["Inter"]`
+   entry #name   nazwa rodziny, jako tekst
+   entry #Topic   nazwa rodziny jako typ literałowy: `"Inter"` dla `Typeface["Inter"]`
+   entry #face   regularna, prosta odmiana pisma kroju, od której wybiera się pozostałe
+       `Face of Topic` o `Weight.Regular`, `Slant.Upright` i `Stretch.Normal`, bez wariacji
+       i bez funkcji, której typ zapisuje `Weights = 400`, `Slanting = "upright"`
+       i `Enabled = Nothing`. `#regular` to ta sama odmiana pisma.
+   entry #regular   regularna, prosta odmiana pisma; to samo co `#face`
+   entry #light   cienka (300) prosta odmiana pisma
+   entry #medium   średnia (500) prosta odmiana pisma
+   entry #semibold   półgruba (600) prosta odmiana pisma
+   entry #bold   gruba (700) prosta odmiana pisma
+   entry #black   czarna (900) prosta odmiana pisma
+   entry #italic   regularna odmiana pisma w kursywie

