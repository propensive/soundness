@ 0 12 0 075d3928f014d4471d2719d0d1d023c3
+         Pierwiastek pokazuje się jako sam symbol, a inspekcjonuje ze znakiem atomu i liczbą
+         atomową, co odróżnia go od każdego innego krótkiego tekstu.
+     entry .showable   pokazuje pierwiastek jako jego symbol, `Fe`
+     entry .inspectable   inspekcjonuje pierwiastek ze znakiem atomu i jego liczbą, `⚛Fe(26)`
+     entry #number   liczba atomowa
+     entry #symbol   symbol chemiczny, `Fe`
+     entry #name   nazwa angielska, `Iron`
+     entry #apply   cząsteczka z tym pierwiastkiem powtórzonym, z licznością jako argumentem typu, `O[2]`
+         `O[2]` to cząsteczka dwóch atomów tlenu: liczność jest literałowym typem liczby
+         naturalnej, więc musi być znana w czasie kompilacji. Dla liczności znanej dopiero w
+         czasie wykonania należy użyć `O ** n`.
+     entry #molecule   ten pierwiastek jako cząsteczka jednego atomu

@ 0 1 0 0077ef00fcb0f3680ffcfc506fc0a4f1
