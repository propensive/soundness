% 6 1 0 1f1bdfbe9b527fd00064a5db9d98d476

% 0 1 0 1feef384701d77fc0c44195b56ed14f9

% 1 1 0 01f9b540372c191e0388a046e8b20cab

% 2 1 0 0e17cf6114133e6e1e646333b285f0f5

@ 0 8 0 0b64a016539c15371cd6053215ca6190
+   entry .approximate   rozkład gamma o danej średniej i odchyleniu standardowym
+       Kształt to średnia² ÷ wariancja, a skala to wariancja ÷ średnia.
+   entry #shape   parametr kształtu, k
+   entry #scale   parametr skali, θ
+   entry #mean   średnia rozkładu, kształt × skala, jako `F64`
+   entry #variance   wariancja rozkładu, kształt × skala², jako `F64`
+   entry #variationCoefficient   współczynnik zmienności, 1 ÷ √kształt, jako `F64`
+   entry #skewness   skośność rozkładu, 2 ÷ √kształt, jako `F64`

