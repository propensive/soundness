@ 0 4 0 12b0633e6411262b15014e9a1d567bfe
+       Dla większości kodowań istnieje alfabet *ścisły*, który deserializuje wyłącznie własne
+       znaki, oraz *tolerancyjny*, który przyjmuje także drugą wielkość liter: `hexLowerCase`
+       zapisuje małymi literami i czyta obie wielkości, a `hexStrictLowerCase` czyta tylko małe
+       litery. Tolerancyjne mają nazwy bez `Strict`, ponieważ to one są zwykłym wyborem.

% 0 1 0 0cf4e9bd1c0d48a5152d6401343504ae

@ 0 34 0 10e8c4bbda9449280164271eb4b18041
+   entry .binaryStandard               binarny: `0` i `1`
+   entry .quaternaryStandard           czwórkowy: `0123`
+   entry .quaternaryDnaNucleotide      czwórkowy jako nukleotydy DNA: `ATCG`
+   entry .octalStandard                ósemkowy: cyfry od `0` do `7`, bez dopełnienia
+   entry .hexStrictUpperCase           szesnastkowy wielkimi literami, czytający tylko wielkie litery
+   entry .hexStrictLowerCase           szesnastkowy małymi literami, czytający tylko małe litery
+   entry .hexUpperCase                 szesnastkowy wielkimi literami, czytający obie wielkości liter
+   entry .hexLowerCase                 szesnastkowy małymi literami, czytający obie wielkości liter
+   entry .hexBioctal                   szesnastkowy „bioctal”, z cyframi `01234567` i literami `cjzwfsbv`
+   entry .base32StrictUpperCase        Base32 z RFC 4648 wielkimi literami, z dopełnieniem, czytający tylko wielkie litery
+   entry .base32StrictLowerCase        Base32 z RFC 4648 małymi literami, z dopełnieniem, czytający tylko małe litery
+   entry .base32UpperCase              Base32 z RFC 4648 wielkimi literami, z dopełnieniem, czytający obie wielkości liter
+   entry .base32LowerCase              Base32 z RFC 4648 małymi literami, z dopełnieniem, czytający obie wielkości liter
+   entry .base32ExtendedHexUpperCase   „base32hex” z RFC 4648 (`0`–`9`, `A`–`V`) wielkimi literami, z dopełnieniem
+       Zapisuje wielkimi literami. Jego tolerancja pochodzi ze standardowego alfabetu Base32
+       małymi literami, a nie z alfabetu extended-hex małymi literami.
+   entry .base32ExtendedHexLowerCase   „base32hex” z RFC 4648 (`0`–`9`, `a`–`v`) małymi literami, z dopełnieniem
+       Zapisuje małymi literami. Jego tolerancja pochodzi ze standardowego alfabetu Base32
+       wielkimi literami, a nie z alfabetu extended-hex wielkimi literami.
+   entry .base32ZBase32                z-base-32, uporządkowanie przyjazne dla ludzi, z dopełnieniem
+   entry .base32ZBase32Unpadded        z-base-32, bez dopełnienia
+   entry .base32Geohash                alfabet Geohash, bez dopełnienia
+   entry .base32WordSafe               alfabet word-safe, który unika układania się w słowa, bez dopełnienia
+   entry .base32Crockford              Base32 Crockforda, bez dopełnienia, czytający `O` jako `0`, `I` i `L` jako `1` oraz obie wielkości liter
+   entry .base64Standard               Base64 z RFC 4648, z `+` i `/`, dopełniany znakiem `=`
+   entry .base64Unpadded               Base64 z RFC 4648, z `+` i `/`, bez dopełnienia
+   entry .base64Url                    Base64 bezpieczny dla URL i nazw plików, z `-` i `_`, bez dopełnienia
+   entry .base64Xml                    Base64 dla nazw XML, z `+` i `-`, dopełniany znakiem `.`
+   entry .base64Imap                   zmodyfikowany Base64 nazw skrzynek pocztowych IMAP, z `+` i `,`, bez dopełnienia
+   entry .base64Yui                    Base64 biblioteki YUI, z `.` i `_`, bez dopełnienia
+   entry .base64Radix64                Radix-64 z OpenPGP, standardowy alfabet, dopełniany znakiem `=`
+   entry .base64Bcrypt                 Base64 z bcrypt, z `.` i `/` na początku, bez dopełnienia
+   entry .base64Sasl                   Base64 z SASL, z `+` i `,`, bez dopełnienia
+   entry .base64Uuencoding             znaki uuencoding, od `!` do `_`, bez dopełnienia
