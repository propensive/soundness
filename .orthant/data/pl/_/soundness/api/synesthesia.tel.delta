@ 0 24 0 00cb949166a008b21742eb3e269f39fd
+         To, co każda strona wysyła o sobie przy inicjalizacji sesji: klient w `initialize`,
+         a serwer w odpowiedzi `Initialize`, gdzie `Mcp.Interface` buduje to z `name`
+         i `version` serwera. Obiekt towarzyszący przechowuje zakotwiczone derywowane kodeki
+         JSON; dekodowanie wymaga `Tactic[Json.Error]`.
+     entry #name   nazwa programu
+     entry #title   czytelny dla człowieka tytuł, jeśli podano
+     entry #icons   ikony reprezentujące program, jeśli podano
+     entry #version   wersja programu, jako tekst
+     entry #description   opis programu, jeśli podano
+     entry #websiteUrl   strona internetowa programu, jeśli podano
+   entry .ClientInfo   nazwa, tytuł, wersja, opis i ikony klienta
+     entry #name   nazwa klienta
+     entry #title   tytuł klienta
+     entry #version   wersja klienta
+     entry #description   opis klienta
+     entry #icons   ikony reprezentujące klienta, jeśli podano
+   entry .ServerInfo   nazwa, tytuł, wersja, opis, ikony i strona internetowa serwera
+     entry #name   nazwa serwera
+     entry #title   tytuł serwera
+     entry #version   wersja serwera
+     entry #description   opis serwera
+     entry #icons   ikony reprezentujące serwer, jeśli podano
+     entry #websiteUrl   strona internetowa serwera, jako `HttpUrl`
+   entry .Initialize   odpowiedź serwera na `initialize`: wersja, możliwości, tożsamość i instrukcje

