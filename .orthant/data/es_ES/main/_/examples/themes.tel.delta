@ 0 3 0 12dba60c9b97fcfb06e48a492f2aa1ee
+       Datos analizados, transformados y escritos en los bloques en que llegaron, sin una copia
+       intermedia, con contrapresión, y con la propiedad exclusiva de cada bloque comprobada por
+       el compilador.

% 0 1 0 0ccede5cd663113f0162899988e3d8a0

@ 0 2 0 031bb7a5db04904e087c2afcb08181bf
