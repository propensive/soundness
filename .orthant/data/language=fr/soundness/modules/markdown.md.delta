= run
- ##
+ ##

- locally:
+ locally:

-   given formatting: Markdown.Formatting = Markdown.Formatting.bounded(80)
+   given formatting: Markdown.Formatting = Markdown.Formatting.bounded(80)

-   Out.println(document.show)
+   Out.println(document.show)

