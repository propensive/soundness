+ ```scala

- import Async.nominative
+ import Async.nominative

- val worker = supervise(task(n"worker")(monitor.name).await())
+ val worker = supervise(task(n"worker")(monitor.name).await())

= val worker = supervise(task(n"worker")(monitor.name).await())
- ```
+ ```

= val worker = supervise(task(n"worker")(monitor.name).await())
= ```
