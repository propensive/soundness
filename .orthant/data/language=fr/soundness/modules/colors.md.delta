+ ##

- Out.println(tomato.rotate(180.deg).to[Srgb].inspect)
+ Out.println(tomato.rotate(180.deg).to[Srgb].inspect)

- Out.println(tomato.lighten(0.2).to[Srgb].inspect)
+ Out.println(tomato.lighten(0.2).to[Srgb].inspect)

- Out.println(tomato.desaturate.to[Srgb].inspect)
+ Out.println(tomato.desaturate.to[Srgb].inspect)

