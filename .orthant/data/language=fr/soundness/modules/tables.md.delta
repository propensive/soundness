+   import columnAttenuation.failAttenuation

-   recover:
+   recover:

-     case Table.Error(minimum, available) =>
+     case Table.Error(minimum, available) =>

-       Out.println(t"The table needs a width of at least $minimum to be shown.")
+       Out.println(t"The table needs a width of at least $minimum to be shown.")

-   . protect:
+   . protect:

-       Out.println(table.tabulate(libraries).grid(30))
