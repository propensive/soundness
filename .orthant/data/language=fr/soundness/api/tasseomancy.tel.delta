+       samples.chart(Histogram()).fit.edges.size      // 5: four bins

-       samples.chart(Histogram(bins = 2)).fit.edges.size   // 3
+       samples.chart(Histogram(bins = 2)).fit.edges.size   // 3

=       samples.chart(Histogram(bins = 2)).fit.edges.size   // 3
-       ```
+       ```

