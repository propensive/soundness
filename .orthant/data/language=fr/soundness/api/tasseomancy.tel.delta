-       import soundness.*
+       import soundness.*

-       val sizes = Series(t"sort")((100, 1.2), (1000, 14.0), (10000, 160.0), (100000, 1900.0))
+       val sizes = Series(t"sort")((100, 1.2), (1000, 14.0), (10000, 160.0), (100000, 1900.0))

-       val logged =
+       val logged =

-         given Int is Calibration = calibrations.logarithmicCalibration
+         given Int is Calibration = calibrations.logarithmicCalibration

-         sizes.chart(Lines())
+         sizes.chart(Lines())

-       logged.fit.abscissa.transform                                  // Scale.Transform.Logarithmic
+       logged.fit.abscissa.transform                                  // Scale.Transform.Logarithmic

-       sizes.chart(Lines(ordinate = calibrations.adaptiveCalibration)).fit.ordinate.transform
+       sizes.chart(Lines(ordinate = calibrations.adaptiveCalibration)).fit.ordinate.transform

=       sizes.chart(Lines(ordinate = calibrations.adaptiveCalibration)).fit.ordinate.transform
-       ```
+       ```

-       The no-import default, `.linear`, is linear and padded. A logarithmic calibration over
-       a range that includes zero or a negative falls back to linear rather than failing.
+       La valeur par défaut sans import, `.linear`, est linéaire et étendue. Un calibrage
+       logarithmique sur une plage qui inclut zéro ou une valeur négative se replie sur un
+       calibrage linéaire au lieu d'échouer.

