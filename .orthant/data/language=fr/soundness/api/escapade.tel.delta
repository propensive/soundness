+         import soundness.*

-         val built: Teletype = Teletype.Builder().build:
+         val built: Teletype = Teletype.Builder().build:

-           append(e"$Bold(one) ")
+           append(e"$Bold(one) ")

-           append(t"two ")
+           append(t"two ")

-           append('3')
+           append('3')

-         built.plain   // t"one two 3"
