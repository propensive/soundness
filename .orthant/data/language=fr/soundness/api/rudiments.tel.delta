-       import soundness.*
+       import soundness.*

-       val names = Bijection(scala.collection.immutable.Map(1 -> t"one", 2 -> t"two"))
+       val names = Bijection(scala.collection.immutable.Map(1 -> t"one", 2 -> t"two"))

-       names.flip.get(t"one")       // Some(1)
+       names.flip.get(t"one")       // Some(1)

-       names.flip.flip.get(1)       // Some(t"one")
+       names.flip.flip.get(1)       // Some(t"one")

-       names.defines(2)             // true
+       names.defines(2)             // true

=       names.defines(2)             // true
-       ```
+       ```

