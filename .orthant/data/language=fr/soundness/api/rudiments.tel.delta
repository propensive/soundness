=         code
-             val count = Atomic(0)
+             val count = Atomic(0)

-             def hit(): Int = count.since(_ + 1)        // incrementAndGet
+             def hit(): Int = count.since(_ + 1)        // incrementAndGet

=             def hit(): Int = count.since(_ + 1)        // incrementAndGet
-       ##
