-       import soundness.*
+       import soundness.*

-       import rudiments.survey
+       import rudiments.survey

-       val line = t"key: value"
+       val line = t"key: value"

-       line.survey: surveyor =>
+       line.survey: surveyor =>

-         val key = surveyor.pace(_ != ':')     // Interval in line.type, 3 long
+         val key = surveyor.pace(_ != ':')     // Interval in line.type, 3 long

-         surveyor.advance()                    // over the ':'
+         surveyor.advance()                    // over the ':'

-         surveyor.pace(_ == ' ')
+         surveyor.pace(_ == ' ')

-         val rest = surveyor.remainder
+         val rest = surveyor.remainder

-         (line.segment(key), line.segment(rest))   // (t"key", t"value")
+         (line.segment(key), line.segment(rest))   // (t"key", t"value")

=         (line.segment(key), line.segment(rest))   // (t"key", t"value")
-       ```
