-     import soundness.*
+       import soundness.*

-     val limit: Bytes = 4.mib
+       val limit: Bytes = 4.mib

-     limit/2.kib             // 2048.0
+       limit/2.kib             // 2048.0

-     (limit + 1.kib).long    // 4195328
+       (limit + 1.kib).long    // 4195328

=     (limit + 1.kib).long    // 4195328
