-       import soundness.*
+         import soundness.*

-       val cursor = Cursor(t"{}")
+         val cursor = Cursor(t"{}")

-       cursor.peek == '{'           // true
+         cursor.peek == '{'           // true

=       cursor.peek == '{'           // true
-       cursor.advance()
+         cursor.advance()

=       cursor.advance()
-       cursor.advance()
+         cursor.advance()

-       cursor.peek == Datum.End     // true
+         cursor.peek == Datum.End     // true

=       cursor.peek == Datum.End     // true
-       ```
+         ```

