-       val expected = Play(t"Othello", Person(t"Othello", 49), List(Person(t"Iago", 28), Person(t"Æmilia", 32)))
+       val expected = Play(t"Othello", Person(t"Othello", 49), List(Person(t"Iago", 28), Person(t"Æmilia", 32)))

-       val observed = Play(t"Othello", Person(t"Othello", 43), List(Person(t"Emilia", 32), Person(t"Iago", 28)))
+       val observed = Play(t"Othello", Person(t"Othello", 43), List(Person(t"Emilia", 32), Person(t"Iago", 28)))

-       expected.contrast(observed)
+       expected.contrast(observed)

=       expected.contrast(observed)
