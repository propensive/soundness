+       import soundness.*

-       val ages = Map(t"Romeo" -> 16, t"Juliet" -> 13)
+       val ages = Map(t"Romeo" -> 16, t"Juliet" -> 13)

-       ages.keys     // Set(t"Romeo", t"Juliet")
+       ages.keys     // Set(t"Romeo", t"Juliet")

-       ages.values   // List(16, 13)
+       ages.values   // List(16, 13)

=       ages.values   // List(16, 13)
-       ```
+       ```

