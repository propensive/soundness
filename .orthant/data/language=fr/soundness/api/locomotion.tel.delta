+     val bytes: Data = Person(t"Percy", 30).in[Protobuf].encode   // the wire bytes

-     Chain(bytes).read[Person in Protobuf]                        // Person(t"Percy", 30)
+     Chain(bytes).read[Person in Protobuf]                        // Person(t"Percy", 30)

-     bytes.read[Protobuf].as[Person]                              // the same, in two steps
+     bytes.read[Protobuf].as[Person]                              // the same, in two steps

=     bytes.read[Protobuf].as[Person]                              // the same, in two steps
-     ```
