+       import soundness.*

-       '\u0003' match
+       '\u0003' match

-         case CtrlChar(letter) => letter   // 'C'
+         case CtrlChar(letter) => letter   // 'C'

-         case _                => '?'
+         case _                => '?'

=         case _                => '?'
