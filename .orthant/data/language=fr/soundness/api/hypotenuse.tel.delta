+       import soundness.*

-     7.0 %% 3.0     // 1.0
+       7.0 %% 3.0     // 1.0

-     -7.0 %% 3.0    // 2.0
+       -7.0 %% 3.0    // 2.0

-     -7 %% 3        // 2
+       -7 %% 3        // 2

=     -7 %% 3        // 2
