+         ```scala

-         import soundness.*
+         import soundness.*

-         val crc = Crc32()
+         val crc = Crc32()

-         crc.append(t"1234".in[Data])
+         crc.append(t"1234".in[Data])

-         crc.append(t"56789".in[Data])
+         crc.append(t"56789".in[Data])

-         crc.value   // 0xcbf43926L
+         crc.value   // 0xcbf43926L

-         crc.reset()
+         crc.reset()

-         crc.value   // 0L
+         crc.value   // 0L

-         ```
+         ```

