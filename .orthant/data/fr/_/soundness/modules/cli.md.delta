% 0 1 0 06ad9756a4ea8ec30c97d603afec1cf1

% 1 1 0 18babe3aa903135912fa7c4ce94b243a

% 2 1 0 12d2f3fd2f3bb055151fb248b81bfa1f

% 3 1 0 11a58e90162eb5031040c81486776098

% 0 1 0 09f97e67067ca680066cc5757413fb87

% 0 1 0 0d9eb79b2ad23e230aa7f51d7b4c2f23

% 0 1 0 005e9ad648615fb30f12414b80890dee

% 1 1 0 0d0ee31695075020158bab8c7c1cbcb3

% 0 1 0 06b5cf56cc6657f919bd455ebd7c4876

% 1 1 0 036bf21fd447ccf50c158c7fb3484a3d

% 0 1 0 1a58044c761fd53b1180bb7ec0ad199b

% 1 1 0 0a6d5f5c6ff0f0f5147fb17f9b6387ff

