% 0 1 0 1d3a59e65fcbdf140fa0a72dc1f0c9fd

% 0 1 0 0965f99efea16faf1f803bfe3ab3fdd8

% 0 1 0 033c48d8fe3380f21cf0cf4cb9eca2b6

% 1 1 0 075a94b94442c6e602b102440c7c1150

% 0 1 0 0dfe854eaee6ff300ce52bc585f547f1

% 0 1 0 1274ef776a68ec3e09ff6526edf9bdb9

% 0 1 0 1b7856209f71157f0292ee57c80137ba

% 0 1 0 1c9d6fd014872435089b50dfe962343a

% 0 1 0 02a42cb4274e0f040dfa9e47606ae606

% 0 1 0 19515b4e6e73adb11045115917c906a8

% 0 1 0 01a60fd9533fe87e022fd5e71a9c9a65

% 1 1 0 0af70766c985a44018b4a04cbe0d202d

% 3 1 0 1b2c594c88b742ab15b41ef0a08a3a21

% 4 1 0 1893869b0af0de75140199519c5c9d55

% 5 1 0 0a760e76562031111f2a20236d30dc73

