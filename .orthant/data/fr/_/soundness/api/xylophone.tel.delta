@ 0 1 0 15929d3f39cac7041bbbc6b8b57e6a9e
+     entry .childIndex
+       info
+           l'indice de l'étiquette d'un enfant parmi les clés des champs non attributs d'un
+           enregistrement, ou `-1`

@ 0 1 0 04938f1b94b03c960e56fe4ab104a88c
+     entry .repeats
+       info
+           si un analyseur recueille les occurrences répétées

@ 0 1 0 02ed54a430a61af106980719a17f40b7
