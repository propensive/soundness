@ 0 1 0 001c07869934ef4e16249b53cd25eeb3
+     entry #length
+       info
+           la longueur de l'intervalle, ou `Unset`

@ 0 1 0 1921b38f9b9830f504dc819ad918dfff
+     entry #describe
+       info
+           `line 3, column 7`

@ 0 1 0 15fc231ab382b27d167da834a152d721
