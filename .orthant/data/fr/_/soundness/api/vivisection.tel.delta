@ 0 1 0 104d7cece888f737188d4db69b015e74
+     entry #name
+       info
+           le nom du champ

@ 1 1 0 1a437b1459546f68073e9ccde02e5487
+     entry #signature
+       info
+           la signature JNI

@ 0 1 0 0d57f75e66ab79cf037196b9ca7957d3
+     entry #modifiers
+       info
+           les indicateurs d'accès ; le bit 0x8 marque un champ statique

@ 0 1 0 046861a9aa2eb64001054dc466541293
+   entry .LineEntry
+     info
+         une ligne de la table des lignes : un indice de bytecode et la ligne de source qui y
+         commence

@ 0 1 0 19308551e7d63f4b10cf9a2f85cb4bbe
