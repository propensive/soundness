% 6 1 0 156f791df8f1b80514f9ab3f3d06e044

% 8 1 0 0f7b5df121917c241731d1da2bacc239

% 0 1 0 05dd48c5e8f0a3a2163bdecd6d8b193c

% 0 1 0 09bc0e714a96f3f2010eaac0ef5ae138

% 1 1 0 1f99f7c6115c03371a96a563695153e3

% 0 1 0 13fdd414253f330913c545a2056fb514

