@ 6 1 0 0fb9d77cded6743b101688ae652dbab5
+           import Lsp.*

@ 8 1 0 162af4bb793453e40753cf66b1eccfeb
+           def register(using Lsp.Registry^): Unit =

@ 1 1 0 0cdbec88e639b4340e81e744a9cf623a
+             command(t"demo.reverse"):

@ 2 1 0 1a19f0ca1a1c9eaa1929520f71425082
+               arguments.let(_.head).let: argument =>

@ 3 1 0 18570dcb539b76d40e82918d5369057c
+                 val text: Text = argument.as[Text]

@ 4 1 0 1cff1d835d12fd6d123b367d3203571d
+                 Text(StringBuilder(text.s).reverse.toString).in[Json]

@ 5 1 0 1f02f59b8c6a074802acb5a3f3e34f0f
+         ```

