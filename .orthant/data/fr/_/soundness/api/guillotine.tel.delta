@ 0 1 0 02940bb78ced41591588b20006611fa8
+         intake.flush()

@ 0 1 0 1178757a119bd465174f9831884ef036
+         job.alive              // true: the pipe is open and cat is still echoing

@ 0 1 0 0f12d4dfc7e9144a0da9864838dbc240
+         intake.put(Data(98, 121, 101, 10))

@ 0 1 0 091d50e094c50cd61e5f31788890a5e3
+         intake.finish()

@ 0 1 0 154285bd38e2411e1df7861324ad29f5
+         job.await().trim       // t"hi\nbye"

