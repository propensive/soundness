@ 3 1 0 13d68feef630d104021ab1fbb6aa6698
+         import soundness.*

@ 4 1 0 1939ad69189450bd1fc54ada0e1cdf19
+         import strategies.throwUnsafely

@ 0 1 0 19a0a63727f7fb4f06cad7d51ff61d3e
+         val source = t"""package test:demo@1.0.0;

@ 0 1 0 17725a7e0377255003658b1277c48c9b
+           world service {

@ 0 1 0 1ec19bcee46785b6198f00feeb84b0a3
+             import wasi:io/streams@0.2.0;

@ 0 1 0 1b58c7d1aedd31ab120c1ba37edce14a
+             import helper;

@ 0 1 0 100e2678cfc2b30810fe6bae03b5c2d8
+             export wasi:http/incoming-handler@0.2.0;

@ 0 1 0 0fb0e8a3ea5ad10710737573c477d302
+           }"""

@ 0 1 0 14aa798c66f2f5eb1a05d93f71ea7931
+         WitDialect.worlds(source).at(t"service").let(_.imports)

@ 0 1 0 093ca65c8e4e753908420f707056a9cc
+         // List(t"wasi:io/streams@0.2.0", t"test:demo/helper@1.0.0")

@ 1 1 0 0fc45b773cc4b7fc188c4b9a7db9b85a
+         ```

