@ 0 3 0 12e30413a4e52848141f51d1364a74d9
+       detail
+           Classées par (plateforme, encodage) : d'abord Windows Unicode complet (3, 10), puis
+           Unicode complet (0, 4) et (0, 6), Windows BMP (3, 1), Unicode BMP (0, 3), les autres
+           Unicode, le symbole Windows (3, 0) et enfin Macintosh Roman (1, 0).

@ 0 1 0 1fc356f7aafb4e9f1a1912ebf16f148c
