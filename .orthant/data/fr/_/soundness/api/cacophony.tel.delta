@ 0 1 0 1a5ae2c2211dee3f09dc794d0675e4d6
+     entry #channels
+       info
+           le nombre de canaux du format

@ 0 1 0 092b744435c1789a04b5341f47a96111
+     entry #sampleRate
+       info
+           la fréquence d'échantillonnage, ou `Unset` si la ligne accepte n'importe quelle
+           fréquence

@ 0 1 0 1d492bdbc521eb260429268b81d5230f
+     entry #bitsPerSample
+       info
+           la profondeur de bits : 8, 16, 24 ou 32

@ 0 1 0 0606cd70f132c74f0f9fac46ec97e6e1
+     entry #encoding
+       info
