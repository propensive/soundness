+       import soundness.*

@ 1 1 0 00119cf9aec9aaa21eaf31d03a7d481a
+       import classloaders.threadContextClassloader

@ 2 1 0 02ed76744485131d17b91a556b493439
+       import workingDirectories.javaBaseWorkingDirectory

@ 0 1 0 043a1e6145bfcb8b09006b74ed58d6c1
+       val trace: StackTrace = Exception("boom").stackTrace.resolved

@ 1 1 0 1697e9ce621fb4581ca4dfc6419e5f3e
+       trace.frames.head.let(_.displayClass)

@ 1 1 0 0e60998a869308cd07ac935d7534279c
+       ```

