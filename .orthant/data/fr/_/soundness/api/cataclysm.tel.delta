+         import soundness.*

@ 0 1 0 06a707affab00f8014cd1d73980e3f8e
+         val sheet = Css(List(

@ 0 1 0 09d1e48e204a39571e6f9116092ab652
+           Css.Node.Rule(SelectorList(List(Selector(Unset, Selector.Compound(List(Selector.Simple.Type(Unset, t"a"))), Nil))),

@ 0 1 0 0fedb8efbdb4e9ea092ef59013b0b202
+             List(Css.Node.Declaration(t"color", t"red"))),

@ 0 1 0 15315b59c8776cd11622e421a63d394c
+           Css.Node.At(t"import", t"url(\"x.css\")", Unset)))

@ 1 1 0 1a47bb0d039feb2e00dca2c42ff485b6
+         ```

@ 0 2 0 0071425b7e1220381e28675cc2230a5e
