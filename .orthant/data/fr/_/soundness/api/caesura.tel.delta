% 0 1 0 0d167756f2131c341a39913ce51e1b4b

% 0 1 0 1a784c8c157e8cd10d6b9fc0ef00df2b

% 0 1 0 177be68b0bac4162093bae7f116dafad

% 1 1 0 05f10c1a154d3d54131e9e0f274ca813

% 2 1 0 021a4f48664b9d5913bbee0bae4642b6

