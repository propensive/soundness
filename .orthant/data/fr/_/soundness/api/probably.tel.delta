@ 0 1 0 051e13b32723cd8612ac72b1a91cc67d
+           test(m"biaxial spread with a gap").over(Axis(t"x")(1, 2, 3), Axis(t"y")(10, 20)):

@ 0 1 0 0abba437830a5d4906e96e60c4129248
+             case (x, y) if x + y != 23 => x*y

@ 0 1 0 01358bbbbf19d48104ef1f0c77673d5b
