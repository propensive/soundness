@ 0 1 0 0d93b11c0795055d0fd1c9f85d6c7f53
+   entry #exclusions
+     info
+         les termes `not:`, chacun étant une sélection à un terme, soustraits après l'admission

@ 0 1 0 0263f24a052382060e62d1d24a29ba38
