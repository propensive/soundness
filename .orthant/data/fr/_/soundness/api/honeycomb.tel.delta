+         import htmlDoms.whatwg.*

@ 6 1 0 009c6f888da3561b0d853fb8d558aad7
+         import strategies.throwUnsafely

@ 0 1 0 01cfa8b31fbfaba00398aed82e62061a
+         t"""<svg><circle r="1"/></svg>""".read[Html of Flow]

@ 0 1 0 194d3a0ab756de130c196e4774c03d82
+         // Svg(Html.Element.foreign("circle", Map(t"r" -> t"1")))

@ 1 1 0 0afcd418b021140615045a52347f5eb0
+         ```

@ 1 1 0 031723889a0bf41d0762658d735c165d
+   entry #Table
