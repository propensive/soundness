+         Ol(Li("Alpha"), Li("Beta")).show == t"<ol><li>Alpha</li><li>Beta</li></ol>"

@ 0 1 0 1a6df42beeb58c6719ef89df45df3509
+         Html.Comment("hello").show == t"<!--hello-->"

@ 0 1 0 0bfe06b0a9a17c6c144908f96997c9a3
+         Br.show == t"<br>"

@ 1 1 0 14ae11c9ecf966671289de822d2b5c07
