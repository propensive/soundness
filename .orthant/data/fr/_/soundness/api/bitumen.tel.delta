+       import strategies.throwUnsafely

@ 0 1 0 087af4f01a893c080a40e1678dc25dbe
+       val bytes: Data = Tarfile(List(Tar.Entry(t"a".as[Tar.Ref], t"A".in[Data]))).source[Data].memoize

@ 0 1 0 03518c58e7b765cf07d1bf6a5230303d
+       bytes.open[Tar]():

@ 0 1 0 0140940967c2e61508799bcade516c55
+         tar.entries.to[List].map(_.entryName)   // List(t"a")

@ 1 1 0 039441795397f3db19cf113931831b91
+       ```

@ 0 1 0 01173eb6a2534c781acad4cfaabd8c7a
+ entry .ar
+   info
+       la poignée de l'archive ouverte dans un bloc `open[Ar]`

@ 0 2 0 0b67711a33d798b312e7a8e51925a183
+   detail
+       Un accesseur inline transparent pour l'`Ar.Handle` qui a été donnée au bloc :
+       `ar.entries` itère sur les membres de l'archive. Il conserve le type précis de la
+       poignée.

@ 2 1 0 0a0a859bb829fe80047d7273e627f220
+       ```scala

