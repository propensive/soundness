@ 0 1 0 1af7bc25bca0ac121831019946cb00f9
+           7

@ 0 1 0 143a335e0bda2536119a3ffee6832fc0
+         // Stdio.Capture(7, t"shown", t"")

@ 1 1 0 1721227818a6deb9070f03b751fe461c
+         ```

