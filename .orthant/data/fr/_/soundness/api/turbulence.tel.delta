% 3 1 0 1744cd58f6ea49271c0372c802440f6b

% 4 1 0 0c14667582fa1509093fdd7db692393d

% 0 1 0 1f1d03ae718edf9b056933833c0a6566

% 0 1 0 18d75c13aa955f80139d6f32f695f4a8

% 0 1 0 099d0abc78de373d1e4cd3deba9e63a2

% 0 1 0 07fe9d06e56e27ab08fa7facbdb03af3

% 1 1 0 186c1727f56a812506675f98a20aa9bf

