@ 4 1 0 1075fe7b7860dce20102579a861cbeaf
+         import calendars.gregorianCalendar

@ 5 1 0 18660a740d06e3ca03019be1a4c59f34
+         import strategies.throwUnsafely

@ 0 1 0 1039922941812ebf0b787967ea50ae37
+         Rrule.parse(t"FREQ=MONTHLY;BYDAY=-1FR", 2024-Jan-1).occurrences.keep(2)

@ 0 1 0 0e4b36e78dc19af3014b6440748c65c7
+         // Chain(2024-Jan-26, 2024-Feb-23)

@ 1 1 0 183b7a97f718da5e0062197b9fd66f81
+         ```

