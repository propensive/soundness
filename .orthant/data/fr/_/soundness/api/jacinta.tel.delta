@ 0 1 0 06aa2af5cb8c4cb6169a62c66e7f410b
+         t"[1, 2, 3]".read[Json].as[List[Int]]                 // List(1, 2, 3)

@ 0 1 0 09510feb718a45bb1c00b7a61a04ea35
+         t"""{"a": 1, "b": 2}""".read[Json].as[Map[Text, Int]] // Map(t"a" -> 1, t"b" -> 2)

@ 0 1 0 02dd5e9c8e97319e0ad9aae3197c72b9
+         t"null".read[Json].as[Unit]                           // ()

@ 1 1 0 1b088156da9b48471a07ade198bf7299
+         ```

