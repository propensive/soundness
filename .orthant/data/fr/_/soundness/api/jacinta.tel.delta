+         import strategies.throwUnsafely

@ 0 1 0 1cdc57769a14db061e8c86d90120bb16
+         import parsing.trackPositions

@ 0 1 0 0f7ea51247475e3b00aa61536dcb6477
+         val tracked = t"{\n  \"a\": 42\n}".read[Json]

@ 0 1 0 0d1d9c87286250f8090113673cf1cfbc
+         tracked.locate(JsonPointer()(t"a")).let(_.line)      // 2

@ 0 1 0 06fcd6d15ccfc18209aa02541222cff3
+         tracked.locateKey(JsonPointer()(t"a")).let(_.column) // 3

@ 1 1 0 1af587480080dd360fff995ea95660f9
+         ```

@ 0 1 0 167444cd70b7f29304841b793eee99c9
