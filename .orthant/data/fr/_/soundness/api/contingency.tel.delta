+       import soundness.*

@ 0 1 0 0083370ada7bf76c0acb13da1681912e
+       List(t"1", t"x", t"3").survive[Int][Number.Error](_.as[Int])   // List(1, 3)

@ 1 1 0 148851b4842984dd1aa5cdd5caece142
+       ```

