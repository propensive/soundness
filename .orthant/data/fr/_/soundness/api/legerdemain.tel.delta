+     info
+         le nom sous lequel la saisie est soumise, et l'id de sa datalist

@ 0 1 0 1ff6d62d1b3e9d3519402ba1830d3221
+   entry #options
+     info
+         les valeurs suggérées

@ 0 1 0 069b28a5910b3279137e8b70b0bc7d06
+   entry #value
+     info
+         le texte de la saisie

@ 0 1 0 064a473e89d5fabc117448668aacebaf
