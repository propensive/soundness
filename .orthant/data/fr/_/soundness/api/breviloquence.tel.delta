% 7 1 0 0e4e97936058e0c5072ae4cc7c332aef

% 2 1 0 1c61a718f9beb3c81b2ef691cfae48e5

% 0 1 0 05f9857e3f22b7e9017a12a8d5741423

% 0 1 0 0c64d7eabf92d3591d8b6f0e29a1185c

