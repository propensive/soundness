@ 3 1 0 176f55c971785df913a6d480544d2765
+         import soundness.*

@ 4 1 0 1311ba15e3f68c9c024b3edc3cf25816
+         import strategies.throwUnsafely

@ 0 1 0 093b92bb1a20e9820734fa95037e82a7
+         val document = t"""{"openapi": "3.0.3", "info": {"title": "x", "version": "1"}}""".read[OpenApi]

@ 0 1 0 0cdda8f257d2f18f1e2b23583a2fc44d
+         capture[OpenApi.Error](t"""{"openapi": "2.0", "info": {"title": "x", "version": "1"}}""".read[OpenApi]).reason

@ 1 1 0 02aa01556b42a97312f38696497bcd47
+         ```

