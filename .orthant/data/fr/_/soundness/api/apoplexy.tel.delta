@ 0 1 0 1e3beeb01e9c458d0358df1d2bb50297
+           (pet.id, pet.name, pet.tag)                    // (Int, Text, Optional[Text])

@ 0 1 0 0315182cf586ecaf1583b8f4afd9cd89
