% 3 1 0 085b18e86d4978a215454316c2dfe5f7

% 0 1 0 0fdf8ff4656033091c3b955b61e7b2e9

% 1 1 0 089f9eb470ce1e7f1330d2a6901e2277

% 0 1 0 175f1a93cada7442102b7a5cff901474

@ 0 1 0 10b1cae0be9b0e001a6afaa06a06d0fe
