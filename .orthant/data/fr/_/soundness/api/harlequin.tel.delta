+               type Form = Srgb

@ 0 1 0 1c5105bf2ded1a6c183d4b520816a133
+               def background: Color in Srgb = WebColors.Black

@ 0 1 0 12be1f334bff8e0e029d03aba2aa7e05
+               def foreground: Color in Srgb = WebColors.White

@ 1 1 0 121369581c344c8e03fe5814df6ad70c
+       frame

@ 0 1 0 108e2b37694051d31a749ceb23d54205
+         label One colour per accent

@ 1 1 0 0dfed74f1fb6f0f60a8fe86dacb49e5b
+         code

@ 2 1 0 1cd0a39ccb000de7066cb0f12668379f
+             given palette: ScalaSyntaxPalette = new Palette:

@ 3 1 0 07b5d3d98573dbe008f1ed0360338ff4
+               type Form = Srgb

@ 4 1 0 046af0df7b880bb01916ca87eef751c7
+               def background: Color in Srgb       = WebColors.Black

@ 5 1 0 0de06815052ab2240844ea0542eeb852
+               def foreground: Color in Srgb       = WebColors.White

@ 6 1 0 159304fdddb5bf221db5fbbe59cbecdf
+               def scalaError: Color in Srgb       = WebColors.Red

@ 7 1 0 0732ec1bf5b875d41565a71e2c928712
+               def scalaNumber: Color in Srgb      = WebColors.Gold

@ 8 1 0 14a97170fadc8375145f5ba74698f8f7
+               def scalaString: Color in Srgb      = WebColors.LimeGreen

@ 9 1 0 1e02b96f93d5e00d1df50155789619c0
+               def scalaTerm: Color in Srgb        = WebColors.Silver

@ 10 1 0 060af502a1be25b809427c4bfa8a159f
+               def scalaType: Color in Srgb        = WebColors.Turquoise

@ 11 1 0 0baec0da803afef61a6f84d5420c810b
