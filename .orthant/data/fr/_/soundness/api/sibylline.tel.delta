@ 3 1 0 026bbeaadff8925b0e17400f0f886cac
+       typecheck

@ 4 1 0 16043f616b7db6f7156adec9be220e92
+       ##

@ 5 1 0 179de008530042a41b209fffa1f79e61
+       claude.session:

@ 0 1 0 11218212b5b0a1cb09936fb30ab98825
+         llm.ask(t"Hello.")

@ 0 1 0 145f229efe736e9b1a9b5bd21fbec897
+         llm.usage

@ 1 1 0 122c601e7e26845e0aeeeec87948e0bf
