+       import strategies.throwUnsafely

@ 0 1 0 0803952cae2aad0e10e9f43d60f7d5aa
+       def upload(using Http.Request): Http.Response =

@ 0 1 0 09ada703ce6a7faf0e181d389bed77a3
+         val parts = request.as[Multipart]

@ 0 1 0 059099e796bb0b7805ce5a3bc045fe77
+         Http.Response(Http.Ok)(t"received the upload")

@ 1 1 0 1266550d211e8bde148c26e872ce8b59
