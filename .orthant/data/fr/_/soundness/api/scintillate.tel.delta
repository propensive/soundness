+       import strategies.throwUnsafely

@ 0 1 0 1c19eec46bf6fc6d05a36fc4f2028b63
+       def secret(using Http.Connection): Http.Response =

@ 0 1 0 05165046fc9ce9971d7b42a7ca9155b5
+         basicAuth((user, password) => user == t"admin" && password == t"hunter2", t"Admin"):

@ 0 1 0 184c1de5bcfe9ae11c5af33d554db44c
+           Http.Response(Http.Ok)(t"the secret")

@ 1 1 0 0b65a8d81486d21908657104bcca2e4d
