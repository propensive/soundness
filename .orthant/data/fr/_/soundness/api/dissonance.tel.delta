@ 0 1 0 04e46d900c6ffc0c0f3ab49e331c0384
+   entry .Changed
+     info
+         une région modifiée : ses suppressions et ses insertions

@ 0 1 0 1b9c9a3d4e5f9dad0752d4b66427319d
+     entry #deletions
+       info
+           les suppressions de la région, dans l'ordre

@ 0 1 0 06abb33260bf0ec61c7e2856c0785827
+     entry #insertions
+       info
+           les insertions de la région, dans l'ordre

