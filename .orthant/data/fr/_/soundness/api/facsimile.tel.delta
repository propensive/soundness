+       def outline(path: Path on Linux): Unit =

@ 1 1 0 10b3b050a6fa96430a2efb63da63bf48
+         PdfFile(path).open(Read & Write): doc ?=>

@ 0 1 0 164bc24cb1381f0e1d97e20287ca6912
+           doc.setBookmarks(List(Bookmark(t"Start", Pdf.Destination.Fit(Prim), Nil)))

@ 1 1 0 10839e0c2ab622e31fd68109762d617d
