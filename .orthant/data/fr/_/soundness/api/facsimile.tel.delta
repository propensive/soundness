% 0 1 0 0ff09fd85a6fbb540f3b2a2530c17d7e

% 0 1 0 05324ab952d132031fa7821cd90c1137

% 1 1 0 05e58c57513ff4fb1664b4fb5914cddd

% 2 1 0 04ea60e84068f7921bdf4ecb54884444

