@ 1 1 0 1ba07a710056c87018d2304fe87f9276
+       import strategies.throwUnsafely

@ 0 1 0 1e1e90f6c681f6f40edfae894b0eec46
+       def pages(path: Path on Linux): Int =

@ 0 1 0 0f629badb7ab23510f86b17c622f34e0
+         path.open[Pdf]():

@ 1 1 0 0276b77903df9f5108a1ad7dfee64207
+           pdf.pageCount

