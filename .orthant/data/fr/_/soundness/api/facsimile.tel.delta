+         import strategies.throwUnsafely

@ 0 1 0 02e1f8b9268a36071b3a6f90ef4184cc
+         val font: Font in Print = Print.font(Print.Courier.bold)

@ 1 1 0 0f4c9fd55fc2d8221b16999d9d1ad04c
+         ```

@ 0 1 0 0123c08c068d176004a0574bf1ae0bc0
