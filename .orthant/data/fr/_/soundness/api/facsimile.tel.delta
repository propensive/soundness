@ 4 1 0 1c35dd510073214607da8bd79058d182
+         import strategies.throwUnsafely

@ 0 1 0 086d3c87ea823cd9127e01e768dd37d5
+         def firstPageText(data: Data): Text =

@ 1 1 0 169107fd7fa25f7a0677698089ba4e99
+           PdfFile(data).open():

@ 2 1 0 1a685ddae0459c4907d33f75cd84607f
+             pdf.page(Prim).text

@ 3 1 0 0917370732a9ec1514a6bbbde76b158d
+         ```

@ 0 1 0 106e4ee6afbb1713132998bde182c29d
+   entry #pageCount
+     info
+         le nombre de pages de l'arbre des pages aplati

@ 0 1 0 0102cfd9b6d8d55003e39e9ba8e909cb
+   entry #destinations
+     info
+         les destinations nommées du document, par nom

@ 0 3 0 1f6002ee91f16aa807cbf12de19a4bd0
+     detail
+         Lit à la fois l'arbre de noms moderne `/Names` → `/Dests` et l'ancien dictionnaire
+         `/Dests` du catalogue, en résolvant chacun en une `Destination` dont la page est donnée
+         par son ordinal dans la séquence de pages aplatie. Un nom dont la cible ne peut être
+         interprétée est omis.

@ 2 1 0 13d40d31123bd24c1b2a417b6e8deb14
