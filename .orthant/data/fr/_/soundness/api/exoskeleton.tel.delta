+       import systems.javaBaseSystem

@ 0 1 0 1daff35678ce6b8600453c8e520497ad
+       import workingDirectories.javaBaseWorkingDirectory

@ 0 1 0 1c5a66d65e35ef3f0dd3456bfd789fd5
+       def file(using Cli): Boolean = Flag[Path on Local](t"file").present

@ 1 1 0 1ddbb1d308f0b31f0c1a4c35464120b9
+       ```

@ 0 1 0 1a36a1737df5e0a30a0ba716c5037100
