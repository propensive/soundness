@ 3 1 0 09359d7bdbf6a9471174c9cd6f6b6908
+       import soundness.*

@ 0 1 0 0e6c5483b8fa6d520f12f68bc82102ef
+       cos(π)               // F64(-1.0)

@ 0 1 0 0924d8ded15ccb740f93b5b4cba1a433
+       sin(π/2)             // F64(1.0)

@ 0 1 0 06140d36234328730750bf0f6e6a61e4
+       hyp(3.0, F64(4.0))   // F64(5.0)

@ 1 1 0 19df789265ee9fc717924f968b7d325d
+       ```

