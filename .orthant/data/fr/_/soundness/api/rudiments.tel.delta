@ 0 1 0 01bf6f107225b2b30d0501b6a6e0a3bf
+             import rudiments.occupied

@ 0 1 0 1b604f942fe4295805d9999f7b46ede1
+             xs.occupied.let(_.head + 1)      // Optional[Int], the addition total inside

@ 1 1 0 17882c064c75821e183f2463d44eec26
