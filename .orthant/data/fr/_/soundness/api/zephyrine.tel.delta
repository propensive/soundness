@ 3 1 0 18d0e2939156e99a0e774d1f0a451ebe
+         import soundness.*

@ 0 1 0 05bebe825de5b534074fb77797c3da14
+         val cursor = Cursor(t"abc")

@ 0 1 0 1361aa329a62d9460225b89adcc0e3f9
+         val count: Int = cursor.lend: region => range => (range: Interval).size   // 3

@ 0 1 0 0da4a454f4783db61bc354934833a939
