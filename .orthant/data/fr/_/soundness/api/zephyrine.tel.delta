@ 0 1 0 126f32416c53c0a207baf119ae5a7e0c
+         val cursor = Cursor(Iterator(t"one", t"two", t"three"))

@ 0 1 0 0998547a8d7401f100f30c508b01dc94
+         cursor.hold:

@ 0 1 0 0e46b2ce119920e7019b86e365947431
+           val start = cursor.mark

@ 0 1 0 0575ef83f2f765eb07228b018bccc031
+           for i <- 1 to 7 do cursor.next()

@ 0 1 0 1ac897f5df117e691f4a214b4741d1e6
+           cursor.grab(start, cursor.mark)   // t"onetwot"

@ 1 1 0 0fafaad054550f6d0d8d78de629f5656
+         ```

