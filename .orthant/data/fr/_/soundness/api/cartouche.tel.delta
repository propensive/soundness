@ 0 1 0 1e182fae5b461ff41a39008d467b9c53
+     entry .around
+       info
+           l'emprise d'une étiquette ancrée en un point d'un côté de sa cible

@ 0 2 0 1ed5b932ccca9c7a158903fd748b2de1
+       detail
+           `Obstacle.Box.around(x, y, width, height, attachment)` : pour `East`, l'ancre est le
+           milieu gauche du rectangle ; pour `North`, le milieu de son bas ; pour `Center`, son
+           centre.

@ 0 1 0 041afb695225b592183de845c1846387
+     entry #left
+       info
+           le bord gauche du rectangle

@ 0 1 0 016f35c2174ed5db1ed8b2fb279416e7
+     entry #top
+       info
+           le bord supérieur du rectangle

@ 0 1 0 1f70853096323e2d075528027bedb8ef
+     entry #width
+       info
+           la largeur du rectangle

@ 0 1 0 0f6bd2749ef9f3061da69ed8322bf263
