% 0 1 0 0c363c0585b58b3c13d264b426a95cf4

% 0 1 0 07fad97a566885071347693917901e42

% 0 1 0 1bfdb582e889d22215525138d4f63116

% 1 1 0 109066aedd987921054b99ad2d8ed12b

