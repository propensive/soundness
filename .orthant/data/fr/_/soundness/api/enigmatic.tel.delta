@ 0 2 0 194d14b3bd4190b1075ccedb5398171b
+     detail
+         Chaque secret reçoit une arène partagée `java.lang.foreign`, mise à zéro et libérée
+         par un cleaner lorsque le secret devient inaccessible. Un cloak neuf par point
+         d'invocation.

@ 0 1 0 18cff9c80837f70c09eb09f8519ca6c1
