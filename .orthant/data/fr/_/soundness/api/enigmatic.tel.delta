@ 0 1 0 1a94ea18d9ba3afe12b51cc7d574e969
+       import alphabets.hexLowerCase

@ 0 1 0 0f4d9e19d1ef50670c38ebaaada625ad
+       t"message".hmac[Sha2[256]](t"secret".in[Data]).serialize[Hex]

@ 1 1 0 061c5e35f69779100049d2b7cad6aac4
