+           import charsets.utf8Charset

@ 0 1 0 0bcd14ac3af2545219185a5b360c9820
+           given Zip.Compression = Zip.Compression.Stored

@ 0 1 0 1ff27b9257ecc4e217ec9f07a585be08
+           Zip.Entry(t"lib/libapp.so".as[Path on Zip], t"payload".in[Data]).aligned(4096)

@ 1 1 0 013461966d21e51b012dacdda0f16c01
+           ```

@ 0 1 0 0d81c8ee7b75dd221677d3e7a48e1bc4
