+ val derived: Data = KeyDerivation.hkdf[Sha2[256]](material, Data(), t"session".in[Data], 32)

- val slow: Data = KeyDerivation.pbkdf2[Sha2[256]](t"hunter2".in[Data], t"salt".in[Data], 4096, 32)
+ val slow: Data = KeyDerivation.pbkdf2[Sha2[256]](t"hunter2".in[Data], t"salt".in[Data], 4096, 32)

