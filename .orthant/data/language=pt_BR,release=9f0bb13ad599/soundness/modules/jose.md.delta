+ val secret = SymmetricKey.generate[HmacCipher[Sha2[256]]]()

- val refusal = capture[Jose.Error](compact.as[Jws].verify(secret))
+ val refusal = capture[Jose.Error](compact.as[Jws].verify(secret))

= val refusal = capture[Jose.Error](compact.as[Jws].verify(secret))
- ```
+ ```

