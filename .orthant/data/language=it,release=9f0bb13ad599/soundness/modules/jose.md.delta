+ ```scala

- val line: Text = compact.as[Jws].verify(key.public).read[Text]
+ val line: Text = compact.as[Jws].verify(key.public).read[Text]

= val line: Text = compact.as[Jws].verify(key.public).read[Text]
- ```
+ ```

