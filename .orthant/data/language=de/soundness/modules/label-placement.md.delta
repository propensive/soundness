+ ```scala

- import soundness.*
+ import soundness.*

- import stdios.javaLangSystemStdio, termcapDefinitions.xterm256Termcap
+ import stdios.javaLangSystemStdio, termcapDefinitions.xterm256Termcap

- given decimalizer: Decimalizer = Decimalizer(5)
+ given decimalizer: Decimalizer = Decimalizer(5)

= given decimalizer: Decimalizer = Decimalizer(5)
- ```
+ ```

