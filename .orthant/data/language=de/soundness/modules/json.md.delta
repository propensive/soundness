+   code

-       val direct =
+       val direct =

-         given Person is Json.Printable = Json.Direct.derived[Person].printable
+         given Person is Json.Printable = Json.Direct.derived[Person].printable

-         Person(t"Hamlet", 30).in[Text over Json]
