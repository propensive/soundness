+ ##

- Out.println((Permutation(Factoradic(45)) == Permutation(Sequence(1, 4, 2, 3, 0))).inspect)
+ Out.println((Permutation(Factoradic(45)) == Permutation(Sequence(1, 4, 2, 3, 0))).inspect)

- Out.println(shuffle.lehmer.inspect)
+ Out.println(shuffle.lehmer.inspect)

