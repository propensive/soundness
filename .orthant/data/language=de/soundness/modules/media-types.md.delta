- import detectables.jsonDetectable
+ import detectables.jsonDetectable

= import detectables.jsonDetectable
=
- cursor match
+ cursor match

-   case Media["application/json", Likely](json) => t"JSON"
+   case Media["application/json", Likely](json) => t"JSON"

-   case _                                       => t"something else"
+   case _                                       => t"something else"

