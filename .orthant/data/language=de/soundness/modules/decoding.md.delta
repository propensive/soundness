+ ```scala

- enum Direction:
+ enum Direction:

-   case North, South, East, West
+   case North, South, East, West

- def direction(text: Text): Optional[Direction] = text match
+ def direction(text: Text): Optional[Direction] = text match

-   case As[Direction](direction) => direction
+   case As[Direction](direction) => direction

-   case _                        => Unset
+   case _                        => Unset

=   case _                        => Unset
- ```
+ ```

=   case _                        => Unset
= ```
