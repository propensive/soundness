+ ```scala

- def recipient(text: Text): EmailAddress = text match
+ def recipient(text: Text): EmailAddress = text match

-   case As[EmailAddress](email) => email
+   case As[EmailAddress](email) => email

-   case _                       => email"nobody@example.com"
+   case _                       => email"nobody@example.com"

=   case _                       => email"nobody@example.com"
- ```
+ ```

=   case _                       => email"nobody@example.com"
= ```
=
- ```scala fuel
+ ```scala fuel

=   case _                       => email"nobody@example.com"
= ```
