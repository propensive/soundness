+ ```scala

- case class Person(name: Text, email: EmailAddress)
+ case class Person(name: Text, email: EmailAddress)

- case class Troupe(leader: Person, name: Text)
+ case class Troupe(leader: Person, name: Text)

- val form = elicit[Troupe](validation = Validation(), submit = t"Save")
+ val form = elicit[Troupe](validation = Validation(), submit = t"Save")

= val form = elicit[Troupe](validation = Validation(), submit = t"Save")
