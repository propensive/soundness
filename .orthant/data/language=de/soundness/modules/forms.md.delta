- t"leader.name=Quince&leader.email=nobody&name=Mechanicals".as[Query].as[Troupe]
+ t"leader.name=Quince&leader.email=nobody&name=Mechanicals".as[Query].as[Troupe]

= t"leader.name=Quince&leader.email=nobody&name=Mechanicals".as[Query].as[Troupe]
