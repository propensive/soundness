+ ```scala

- def displacement
+ def displacement

-     ( initial: Quantity[Metres[1] & Seconds[-1]],
+     ( initial: Quantity[Metres[1] & Seconds[-1]],

-       time:    Quantity[Seconds[1]],
+       time:    Quantity[Seconds[1]],

-       accel:   Quantity[Metres[1] & Seconds[-2]] )
+       accel:   Quantity[Metres[1] & Seconds[-2]] )

- :   Quantity[Metres[1]] =
+ :   Quantity[Metres[1]] =

-   initial*time + 0.5*accel*time*time
+   initial*time + 0.5*accel*time*time

=   initial*time + 0.5*accel*time*time
- ```
+ ```

=   initial*time + 0.5*accel*time*time
= ```
