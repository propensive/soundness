+ Out.println(period.has(Instant(0L)).inspect)

- Out.println(period.has(Instant(3_600_000L)).inspect)
+ Out.println(period.has(Instant(3_600_000L)).inspect)

= Out.println(period.has(Instant(3_600_000L)).inspect)
