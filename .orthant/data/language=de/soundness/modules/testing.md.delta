= colored by package:
=
= ```scala fuel
- typecheck
+ typecheck

= colored by package:
=
= ```scala fuel
= typecheck
- ##
+ ##

- val profile = Profile()
+ val profile = Profile()

- profile(m"pipeline hotspots")(target = 5*Second):
+ profile(m"pipeline hotspots")(target = 5*Second):

-   '{ Benchmarks.pipeline() }
+   '{ Benchmarks.pipeline() }

=   '{ Benchmarks.pipeline() }
