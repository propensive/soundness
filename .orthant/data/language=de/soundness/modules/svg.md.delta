+ ```scala

- import dysasymptotics.linearSize
+ import dysasymptotics.linearSize

- val svg = t"""<svg width="50" height="50"><rect x="0" y="0" width="10" height="10"/></svg>"""
+ val svg = t"""<svg width="50" height="50"><rect x="0" y="0" width="10" height="10"/></svg>"""

-         . read[Svg]
+         . read[Svg]

=         . read[Svg]
- ```
+ ```

=         . read[Svg]
= ```
