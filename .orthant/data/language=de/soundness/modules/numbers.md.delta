+ ```scala

- val array = Array(10, 20, 30)
+ val array = Array(10, 20, 30)

- var total = 0
+ var total = 0

- array.extent.each { ordinal => total += array(ordinal) }
+ array.extent.each { ordinal => total += array(ordinal) }

= array.extent.each { ordinal => total += array(ordinal) }
- ```
+ ```

= array.extent.each { ordinal => total += array(ordinal) }
= ```
=
- ```scala fuel
+ ```scala fuel

= array.extent.each { ordinal => total += array(ordinal) }
= ```
=
= ```scala fuel
- run
+ run

= array.extent.each { ordinal => total += array(ordinal) }
= ```
=
= ```scala fuel
