- column  Slack
+ column  Spielraum

- column  Identifier (`0.9`)
+ column  Identifier (`0.9`)

- column  Year (`0.5`)
+ column  Year (`0.5`)

- column  LoC (`0.3`)
+ column  LoC (`0.3`)

- row  `0.6`  hidden  shown  shown
- row  `0.4`  hidden  hidden  shown
