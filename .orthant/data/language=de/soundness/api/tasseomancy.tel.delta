+     val south = Series(t"south")((t"jan", 2.0), (t"feb", 1.0), (t"mar", 6.0))

-     val sales = List(north, south).chart(Bars())
+     val sales = List(north, south).chart(Bars())

-     sales.fit.bands.categories           // Sequence(t"jan", t"feb", t"mar")
+     sales.fit.bands.categories           // Sequence(t"jan", t"feb", t"mar")

-     sales.fit.ordinate.upper             // 6.0, padded to a whole gradation step
+     sales.fit.ordinate.upper             // 6.0, padded to a whole gradation step

-     sales.in[Svg].in[Xml].show.keep(4)   // t"<svg"
+     sales.in[Svg].in[Xml].show.keep(4)   // t"<svg"

