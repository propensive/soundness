=         ```scala
-         import soundness.*
+         import soundness.*

-         val lines = List
+         val lines = List

-           ( t"diff --git a/notes.txt b/notes.txt",
+           ( t"diff --git a/notes.txt b/notes.txt",

-             t"--- a/notes.txt",
+             t"--- a/notes.txt",

-             t"+++ b/notes.txt",
+             t"+++ b/notes.txt",

-             t"@@ -1 +1 @@",
+             t"@@ -1 +1 @@",

-             t"-Remember the milk",
+             t"-Remember the milk",

-             t"+Remember the milk and the eggs" )
+             t"+Remember the milk and the eggs" )

-         val files = Git.Patch.parse(lines)
+         val files = Git.Patch.parse(lines)

-         files.head.let(_.status)   // Git.Delta.Status.Modified
+         files.head.let(_.status)   // Git.Delta.Status.Modified

-         files.head.let(Git.Patch.asDiff(_).edits.size)   // 2
+         files.head.let(Git.Patch.asDiff(_).edits.size)   // 2

=         files.head.let(Git.Patch.asDiff(_).edits.size)   // 2
