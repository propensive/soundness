-     import soundness.*
+     import soundness.*

-     val table: Text = Text.build:
+     val table: Text = Text.build:

-       for row <- 1 to 3 do
+       for row <- 1 to 3 do

-         append(t"row ")
+         append(t"row ")

-         appendln(row)
+         appendln(row)

=         appendln(row)
