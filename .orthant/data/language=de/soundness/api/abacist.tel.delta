-         import soundness.*
+         import soundness.*

-         val time: TimeSeconds = Quanta(1, 30, 0)
+         val time: TimeSeconds = Quanta(1, 30, 0)

-         time.long   // 5400
+         time.long   // 5400

=         time.long   // 5400
