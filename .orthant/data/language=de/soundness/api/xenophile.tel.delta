-       import soundness.*
+       import soundness.*

-       val last: Int =
+       val last: Int =

-         Foreign["kotlin.internal.ProgressionUtilKt", Kotlin]
+         Foreign["kotlin.internal.ProgressionUtilKt", Kotlin]

