-         import soundness.*
+         import soundness.*

-         def passThrough(label: Text): Toolchain.Tool = new Toolchain.Tool:
+         def passThrough(label: Text): Toolchain.Tool = new Toolchain.Tool:

-           type Settings = Unit
+           type Settings = Unit

-           def name: Text = label
+           def name: Text = label

-           def initial: Unit = ()
+           def initial: Unit = ()

-           def run
+           def run

-             ( settings:    Unit,
+             ( settings:    Unit,

-               input:       Deliverable,
+               input:       Deliverable,

-               entryPoints: List[EntryPoint],
+               entryPoints: List[EntryPoint],

-               out:         Path on Linux )
+               out:         Path on Linux )

-             ( using Monitor, System, WorkingDirectory )
+             ( using Monitor, System, WorkingDirectory )

-             ( using Tactic[Link.Error], (LinkEvent is Loggable)^ )
+             ( using Tactic[Link.Error], (LinkEvent is Loggable)^ )

-           :   Deliverable =
+           :   Deliverable =

-             input
+             input

=             input
-         ```
+         ```

-         The built-in tools are private to their edge providers; what a user holds is the
-         `Edge`, whose `tool.name` is what a path reports.
+         Die eingebauten Werkzeuge sind privat für ihre Kantenlieferanten; was ein Benutzer in
+         der Hand hält, ist die `Edge`, deren `tool.name` das ist, was ein Pfad meldet.

