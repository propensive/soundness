+         suite(m"Numbers"):

-           test(m"a decimal integer parses"):
+           test(m"a decimal integer parses"):

-             safely(t"42".as[Int])
+             safely(t"42".as[Int])

=             safely(t"42".as[Int])
-           . assert(_ == 42)
+           . assert(_ == 42)

-         aspirationally:
