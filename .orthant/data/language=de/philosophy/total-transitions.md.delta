+ parse

= parse
- frame
+ frame

-   label Yesterday
+   label Gestern

=   label Yesterday
-   code
+   code

=   label Yesterday
=   code
-       enum Connection:
+       enum Connection:

=   label Yesterday
=   code
=       enum Connection:
-         case Open(socket: Socket)
+         case Open(socket: Socket)

=   label Yesterday
=   code
=       enum Connection:
=         case Open(socket: Socket)
-         case Failed(reason: Text)
+         case Failed(reason: Text)

=   label Yesterday
=   code
=       enum Connection:
=         case Open(socket: Socket)
=         case Failed(reason: Text)
-         case Closed
+         case Closed

=         case Closed
- frame
