% 1 1 0 0478911e3903bb830fb1a9a5a04bd82f

% 0 1 0 1457ee408fccd7500ff8a0626c5c90f9

% 0 1 0 194f80834031ff480e8a3f0c4ed07071

% 0 1 0 0505914d45a7d63910e10da63e9d8742

