% 0 1 0 0936ffe62a4c4b001d8f150cdb1035d2

% 1 1 0 1b3c3204af62b497149d6172c670e36e

% 1 1 0 16182c854be8173e1fd30ec842df2be4

% 1 1 0 06dab534789db9061e3e3b25e9afeab9

