+     entry #completionProvider   Vervollständigung, mit ihren Optionen
+     entry #hoverProvider   Hover
+     entry #definitionProvider   zur Definition springen
+     entry #referencesProvider   Referenzen finden
+     entry #documentSymbolProvider   Dokumentsymbole
+     entry #documentFormattingProvider   Formatierung des ganzen Dokuments
+     entry #renameProvider   Umbenennen
+     entry #codeActionProvider   Code-Aktionen
+     entry #signatureHelpProvider   Signaturhilfe, mit ihren Auslösezeichen
+     entry #declarationProvider   zur Deklaration springen
+     entry #typeDefinitionProvider   zur Typdefinition springen
+     entry #implementationProvider   zur Implementierung springen
+     entry #documentHighlightProvider   Hervorhebungen im Dokument
+     entry #foldingRangeProvider   Faltbereiche
+     entry #selectionRangeProvider   Auswahlbereiche
+     entry #colorProvider   Dokumentfarben und Farbdarstellungen
+     entry #documentRangeFormattingProvider   Formatierung von Bereichen
+     entry #documentLinkProvider   Dokumentlinks, mit ihren Optionen
+     entry #codeLensProvider   Code-Lenses, mit ihren Optionen
+     entry #documentOnTypeFormattingProvider   Formatierung beim Tippen, mit ihren Auslösezeichen
+     entry #callHierarchyProvider   Aufrufhierarchie
+     entry #typeHierarchyProvider   Typhierarchie
+     entry #semanticTokensProvider   semantische Tokens, mit ihrer Legende
+     entry #inlayHintProvider   Inlay-Hinweise
+     entry #inlineValueProvider   Inline-Werte
+     entry #linkedEditingRangeProvider   verknüpfte Bearbeitungsbereiche
+     entry #monikerProvider   Moniker
+     entry #diagnosticProvider   Pull-Diagnosen, mit ihren Optionen
+     entry #workspaceSymbolProvider   Workspace-Symbole
+     entry #executeCommandProvider   Befehle, mit ihren Namen
+   entry .InitializeResult   die Antwort des Servers auf `initialize`: seine Capabilities und seine Identität

