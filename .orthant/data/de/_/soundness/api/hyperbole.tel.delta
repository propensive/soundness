% 0 1 0 109ae64d1f2c3f160b747bcab6438096

% 1 1 0 00596dc2fc8f8fa80ec47580377d1df9

% 2 1 0 0a5a6b136741710a1946369bd8e09f56

% 0 1 0 1f2ae059e1f4bd9a1aca20f622222eac

