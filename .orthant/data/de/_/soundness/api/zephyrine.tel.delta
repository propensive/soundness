% 7 1 0 1730aa11dbabd5ea13600468a2304827

% 0 1 0 14a1c9e9619c69440d1984add2658069

% 0 1 0 160c77780c7d0f5d02f5d34110df5c7e

% 0 1 0 00360ed7642d03d6057868baa5f3c03c

% 1 1 0 1517187fe4c83cd00aeeba99b99c3299

% 1 1 0 18454649d59a46751d276d3449da6f0d

% 0 1 0 127f5cd70a2338820e5b52260ff146be

