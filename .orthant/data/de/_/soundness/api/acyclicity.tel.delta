% 3 1 0 19e3c991cf90d5ed0ae0668bff72ec1d

% 4 1 0 1dbe153da1025115126649f70469aa31

% 0 1 0 19877de71de69ee10465826305d991a2

% 2 1 0 004c0adadec701491334a77b825aff89

% 0 1 0 0c2d64177b1feaef050d95aed39e9521

