% 0 1 0 1732ebe4c1d034be041642b5a29eabac

% 0 1 0 0cafeed3ac3acc16172476287c96fe29

% 1 1 0 157c4e0ddf4b1fc70e0717d6fdcf581b

% 0 1 0 0ed9ca72542ad92c0cbb8001949c6ba7

