% 1 1 0 1d080d28a9f2fffa144a27574d0e56be

@ 0 6 0 118c8b7586d406de0bd478af7da7b711
+   entry .exponentialForeverTenacity   zehn Millisekunden, wachsend um 1.2 pro Versuch, ohne Grenze
+   entry .exponentialFiveTimesTenacity   zehn Millisekunden, wachsend um 1.2 pro Versuch, für höchstens fünf Versuche
+   entry .exponentialTenTimesTenacity   zehn Millisekunden, wachsend um 1.2 pro Versuch, für höchstens zehn Versuche
+   entry .fixedNoDelayForeverTenacity   wiederholt sofort, ohne Grenze
+   entry .fixedNoDelayFiveTimesTenacity   wiederholt sofort, für höchstens fünf Versuche
+   entry .fixedNoDelayTenTimesTenacity   wiederholt sofort, für höchstens zehn Versuche
