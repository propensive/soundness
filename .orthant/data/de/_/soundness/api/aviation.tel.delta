% 0 1 0 0c6c2f12a532ce8c1de7cdba516d22a2

% 1 1 0 1ab19ea903e62b4d0eb4362a418db28d

% 2 1 0 1b41a1995cd54efb0526b6e3432672d9

% 3 1 0 1e3172a601a7ea0c142f3c9e00da4f03

