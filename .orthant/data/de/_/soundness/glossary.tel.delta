@ 0 2 0 1c04f0014b70240a0cff64dc47fb9efa
+       Ein [Kontextwert] vom Typ `Tactic[E]`, den eine Methode braucht, um einen Fehler vom Typ
+       `E` zu melden. Wer die Taktik bereitstellt, entscheidet, wie das Scheitern behandelt wird.

% 0 1 0 1440b4e607ea95dd080beafdbd4cd209

@ 1 0 0 1440b4e607ea95dd080beafdbd4cd209
+   term Tag

% 1 1 0 052ca9b589ce49970dc3da26eb031024

@ 0 3 0 09b268591447218717ca9e6c7494cf50
+       Eine kurze Markierung an einem Wert, die sagt, welche Art von Wert er ist oder wie er
+       heißt, etwa der Name eines HTML-Elements, der Typ eines YAML-Knotens oder eines ASN.1-Werts
+       oder der Name, der einem Git-Commit gegeben wird.

% 0 1 0 0db05990284da8a2064a9df272b4e9ad

@ 1 0 0 0db05990284da8a2064a9df272b4e9ad
+   term  getaggte Union

% 1 1 0 089da64ef864cdc90a8561a62dbba0bb

@ 0 2 0 057f52b675c48ee611f79a5c2455a85d
+       Ein Typ, dessen Werte jeweils einer von mehreren Fällen sind, mit einem [Tag], das sagt,
+       welcher Fall es ist, etwa ein Sealed Trait oder eine Aufzählung, oder ein JSON-Objekt mit
+       einem Feld, das seinen Fall nennt.

% 0 1 0 107fa201e29d69c7063c442c0ec4c2be

@ 1 0 0 107fa201e29d69c7063c442c0ec4c2be
+   term Zeilenumbruch

% 1 1 0 02df3c09d616bd6f02d19dd628d9ef7f

@ 0 2 0 02d0c6ead32a122114cc52288dfeec85
+       Das Umbrechen von Text in Zeilen, die in eine gegebene Breite passen, an Leerzeichen oder
+       an erlaubten Trennstellen, wie wenn Text in einem Terminal oder einer Tabelle gesetzt wird.

% 0 1 0 16bd942fe54883c201724bdb2ef81bd1

@ 0 1 0 024929468fe4a0351660628688fab803
+   term Teilstrich

% 1 1 0 0459b337cf0510610b44bf3e3abb6f7c

@ 0 2 0 12edcfa46f01df4619cc6c821b26570e
+       Eine kurze Markierung auf der Achse eines Diagramms an einem regelmäßigen Wert, meist mit
+       einer Beschriftung, die diesen Wert angibt.

% 0 1 0 03ecc68c94cb6ece1d72f4cef7bc361d

@ 0 1 0 1ee54526627afa4f084d6604a7ed41af
+   term Zeitskala

% 1 1 0 1f7779395db4eb4e094c251895383031

@ 0 2 0 118ac51e4111daf50a8376578ddfe355
+       Eine physikalische Skala der Zeit, etwa die Unix-Zeit oder TAI, auf der ein Zeitpunkt
+       liegt. Der Typ eines Zeitpunkts nennt seine Zeitskala, wie in `Instant over Unix`.

% 0 1 0 1d2f750b7b9bc4b703a0762caca75d54

@ 0 1 0 09b7cf10ed9dfb8f0a34a903c780e796
+   term Zeitspanne

% 1 1 0 1b62d42b150013da10d7102030335551

@ 0 3 0 0eb532eb815862ec1b3f4e1f4994dd11
+       Eine Menge an Kalenderzeit, in Jahren, Monaten, Wochen, Tagen, Stunden und Minuten, deren
+       Länge in Sekunden davon abhängt, wann sie angewendet wird. Eine `Duration` ist dagegen eine
+       feste Anzahl von Sekunden.

% 0 1 0 0014815a9747dd39073fd46abbc0d477

@ 1 0 0 0014815a9747dd39073fd46abbc0d477
+   term Tokenizer

% 1 1 0 1470572d1db115281f9ee676ba42bb5c

@ 0 2 0 0ee0c318e243327a13ca9d2f79def54b
+       Die erste Stufe des Parsens, die Quelltext in Token zerlegt, etwa Schlüsselwörter,
+       Bezeichner, Literale und Satzzeichen, bevor deren Struktur analysiert wird.

% 0 1 0 049fee600887b6ed14c8bc0c28605bc8

@ 0 1 0 02884db99ab836de0aa8cfd6b356f48f
+   term Toolchain

% 1 1 0 06d8e38023a47f0901ac93be57a1d0d8

@ 0 2 0 051cc009ba3b24200956181d2dbe54d4
+       Die Menge der Werkzeuge, die zusammen aus Quellcode etwas Ausführbares machen, etwa ein
+       Compiler, ein Linker und ein Paketierer, mit den Versionen und Einstellungen, mit denen sie
+       laufen.

% 0 1 0 03c8455ac18c96281799bd7fb85a8818

@ 1 0 0 03c8455ac18c96281799bd7fb85a8818
+   term Trailer

% 1 1 0 045642ff7083d909131e82d8c5719519

@ 0 3 0 06bad87e1839292003574f276184169c
+       Daten, die nach dem Hauptinhalt einer Nachricht oder Datei kommen statt davor, etwa die
+       HTTP-Trailer, die nach dem Body einer Antwort gesendet werden, oder die Struktur am Ende
+       eines ZIP-Archivs oder einer PDF-Datei.

% 0 1 0 1967ac390071d53206c66c1548d9e759

@ 0 1 0 14156cc643b4b8c51541cbb7dbd91bde
+   term Typklasse
+   keyword typeclass

% 1 1 0 19aa6ace76ee9e741a52fb00ee78a778

@ 0 4 0 0b0fd245eeede47006ea08dda07843ca
+       Ein Trait, der eine Fähigkeit beschreibt, die ein Typ haben kann, etwa angezeigt, kodiert
+       oder verglichen zu werden, mit einer Instanz für jeden Typ, der sie hat. Eine Instanz wird
+       als [Kontextwert] gefunden, sodass ein Typ eine Fähigkeit gewinnt, ohne geändert zu werden.
+       `Color is Showable` ist die Instanz, die `Color` anzeigbar macht.

% 0 1 0 03f69b0a39f7907f1946afc4f6b396d8

@ 1 1 0 0fe3a420e6e1bc651d9375955327439b
+   term Schriftart

% 2 1 0 141b5907d5fb7c7504738286643c69f6

@ 0 2 0 0a99e6ff5bc552f30b15a1516c8bd6f6
+       Eine Schriftfamilie, etwa Inter, benannt durch ein `Typeface`, unabhängig von Stärke,
+       Neigung oder Datei. Ein [Schriftschnitt] wählt einen Stil aus ihr.

% 0 1 0 00c8a953fdc869a603f6ccc27ecdaa8c

@ 1 0 0 00c8a953fdc869a603f6ccc27ecdaa8c
+   term Variante

% 1 1 0 077f06241ef53042187aa0d4ccca5fa5

@ 0 2 0 00ac966306e300ec1f4ffb760f7bc2c6
+       Eine von mehreren alternativen Formen derselben Sache, etwa das URL-sichere Alphabet von
+       Base64, ein Dialekt von Text mit Trennzeichen oder eine Alternative eines TEL-Selects.

% 0 1 0 108314c2b1db539f042d198a9b8b8f26

@ 1 0 0 108314c2b1db539f042d198a9b8b8f26
+   term Viewport

% 1 1 0 1f8dc04b53f0ef4a031df6ff8bf88a9a

@ 0 2 0 08e2ab96860dbd04099eb40eb073f580
+       Das Rechteck, in dem etwas gezeigt wird, etwa der sichtbare Bereich eines Browserfensters,
+       von dem CSS-Einheiten wie `Vw` Bruchteile sind, oder der Bereich, in den ein SVG-Bild
+       gezeichnet wird.

% 0 1 0 13edf8a3c098fb1d0811fc4eed6ab569

@ 1 0 0 13edf8a3c098fb1d0811fc4eed6ab569
+   term Übertragungsform

% 1 1 0 1dd9a9debe4beb431c75e3dac3343a76

@ 0 3 0 0d0ebdd7349984820ced87947c5a38e3
+       Die Form, die ein Wert annimmt, wenn er zwischen Programmen gesendet wird, in einem
+       Protokoll oder einem serialisierten Format, im Unterschied zu seiner Form in Scala: der
+       Name, unter dem ein Feld gesendet wird, der Code, als der ein Fehler gesendet wird, oder
+       die Bytes seiner Kodierung.
