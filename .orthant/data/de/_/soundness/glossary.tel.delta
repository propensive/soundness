@ 0 1 0 12342b3e5daf05d41b440dfe44dc4861
+   term Berechtigung

% 1 1 0 033f33501eef489d0c2ed1a40834c2ca

@ 0 3 0 025502ff1adb6d1d19fc9af47f52d0df
+       Eine der Zugriffsarten, mit denen ein [Handle] geöffnet wird, etwa `Read`, `Write` oder
+       `Exclusive`. Berechtigungen stehen im Typ des Handles, sodass eine Operation, für die keine
+       erteilt wurde, nicht kompiliert.

% 0 1 0 00f3411913d91bb113a3637f96b8de18

@ 0 1 0 14f0e7fb003d4bfd15cd065da12fe28d
+   term Graphem-Cluster

% 1 1 0 1df21237722eb8790723e58a1637fc66

@ 0 3 0 01655e54b8c887c9010aed01f0e54504
+       Eine Folge von einem oder mehreren Unicode-Zeichen, die ein Leser als ein einziges Zeichen
+       wahrnimmt, etwa ein Buchstabe mit kombinierenden Akzenten oder ein Emoji aus mehreren
+       Codepunkten.

% 0 1 0 135064890c2eca2d0557074f81fd26dc

@ 0 1 0 01cafce4528323071dd6d60eb5c2dc9c
+   term Handle

% 1 1 0 117b7f0b119ae9950725e32c03307cfe

@ 0 3 0 1cdec3ef2d87970e03b9dcfa30462f74
+       Ein Wert, der für die Dauer eines Geltungsbereichs Zugriff auf eine geöffnete Ressource
+       gibt, etwa eine Datei, eine Zeichenfläche oder ein Repository. Sein Typ sagt, für welche
+       Operationen es geöffnet wurde, und die Ressource wird geschlossen, wenn der Geltungsbereich
+       endet.

% 0 1 0 10f428add9959f9706b77776b902dfdc

@ 1 0 0 10f428add9959f9706b77776b902dfdc
+   term Handler

% 1 1 0 1bcb0ed7858f5a1f1ce8c9e332e12a01

@ 0 3 0 0b331c7842bd62e30d5f43d0e9c40506
+       Eine Funktion, die übergeben wird, um ausgeführt zu werden, wenn etwas eintrifft oder
+       geschieht, etwa eine Anfrage, die einen Server erreicht, oder eine Nachricht einer
+       Gegenstelle. Er entscheidet, was damit geschieht und, bei einer Anfrage, welche Antwort
+       zurückgegeben wird.

% 0 1 0 12cc98e8c16ab7c71a3f8b55d02904f8

@ 1 0 0 12cc98e8c16ab7c71a3f8b55d02904f8
+   term Harness

% 1 1 0 0e5befd10c74da781f57d40894ce5f1e

@ 0 2 0 1d7464b50b2880801920a4469b07cda3
+       Der Code, der anderen Code unter kontrollierten Bedingungen ausführt und beobachtet, etwa
+       das `Harness`, das einen Test ausführt und aufzeichnet, was es erfasst, oder ein
+       Benchmark-Harness.

% 0 1 0 0fa90a87ae9e65011ed0a322038e6a3b

@ 0 1 0 116c3a43a83f31640567d6333c20a029
+   term  ehrliche Signatur

% 1 1 0 0189e2cd927d64491487ef186e5bbdf8

@ 0 2 0 1f9318377a190b3a0fe4041e4b8a6b57
+       Eine Methodensignatur, die alles angibt, was die Methode braucht, und jede Art, auf die sie
+       scheitern kann, sodass nichts über ihren Aufruf der Dokumentation überlassen bleibt.

% 0 1 0 19dd8489827a9ff51cea2c298f10875e

@ 0 1 0 17546d609edc4e600b76a10164733150
+   term unveränderlich

