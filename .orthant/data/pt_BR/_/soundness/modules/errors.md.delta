% 0 1 0 135c3a6e35fe49b51725d5fdd31c2c82

% 0 1 0 1c0cc4e67560abc7156f423c42356789

% 0 1 0 1bf36c597d75835812db8f4aed55d39f

% 1 1 0 04dd051eeeb84bb31609ef0046523b97

