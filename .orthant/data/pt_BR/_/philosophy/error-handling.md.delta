% 0 1 0 185f50e245cb7f5200e3a271b5a707c6

% 0 1 0 1bb6afcda6024d98027d069a09f7a3ea

% 0 1 0 1c55fbbcf6318633118756417fe99410

% 1 1 0 181226f75334611a06f7fcb33a4368f4

