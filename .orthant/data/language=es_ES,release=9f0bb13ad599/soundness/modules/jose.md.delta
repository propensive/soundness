- ```scala
+ ```scala

- val wrapped: Jwe =
+ val wrapped: Jwe =

-   Jwe[AesGcm[256]]
+   Jwe[AesGcm[256]]

-     ( t"Speak the speech, I pray you",
+     ( t"Speak the speech, I pray you",

-       recipient.public,
+       recipient.public,

-       Jose.Header(algorithm = t"ECDH-ES+A256KW") )
