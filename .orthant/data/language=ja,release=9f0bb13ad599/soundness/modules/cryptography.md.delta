+ val authorityKey = PrivateKey.generate[Ecdsa[256]]()

- val authorityName = Distinguished(commonName = t"Example Root")
+ val authorityName = Distinguished(commonName = t"Example Root")

- val trusted =
+ val trusted =

-   Certificate.selfSigned(authorityName, authorityKey, validity, BigInt(1), authority = true)
+   Certificate.selfSigned(authorityName, authorityKey, validity, BigInt(1), authority = true)

- val issued =
+ val issued =

-   Certificate.issued(subject, tlsKey.public, authorityName, authorityKey, validity, BigInt(2))
+   Certificate.issued(subject, tlsKey.public, authorityName, authorityKey, validity, BigInt(2))

=   Certificate.issued(subject, tlsKey.public, authorityName, authorityKey, validity, BigInt(2))
- ```
