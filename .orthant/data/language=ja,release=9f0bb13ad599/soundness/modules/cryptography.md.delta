+ ```scala

- val envelope: Data = Cose(document.in[Data], signer).in[Data]
+ val envelope: Data = Cose(document.in[Data], signer).in[Data]

= val envelope: Data = Cose(document.in[Data], signer).in[Data]
- ```
+ ```

