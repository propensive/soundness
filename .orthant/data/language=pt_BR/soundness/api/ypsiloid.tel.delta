-             val outer = out.open()
+             val outer = out.open()

-             out.key("x"); out.long(point.x)
+             out.key("x"); out.long(point.x)

-             out.key("y"); out.long(point.y)
+             out.key("y"); out.long(point.y)

-             out.close(outer)
+             out.close(outer)

