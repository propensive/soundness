-       import soundness.*
+       import soundness.*

-       val bands = Bands(Sequence(t"jan", t"feb", t"mar"))
+       val bands = Bands(Sequence(t"jan", t"feb", t"mar"))

-       bands.index(t"feb")    // 1
+       bands.index(t"feb")    // 1

-       bands.centre(1)        // 0.5
+       bands.centre(1)        // 0.5

-       bands.index(t"apr")    // Unset
+       bands.index(t"apr")    // Unset

=       bands.index(t"apr")    // Unset
-       ```
+       ```

=       ```
