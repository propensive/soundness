+       import soundness.*

-       val system: Path on Windows = (Drive('C') / "Windows").on[Windows]
+       val system: Path on Windows = (Drive('C') / "Windows").on[Windows]

-       Drive('C') == C   // true
+       Drive('C') == C   // true

=       Drive('C') == C   // true
-       ```
+       ```

