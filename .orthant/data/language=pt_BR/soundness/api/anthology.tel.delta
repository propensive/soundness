+       val toolchain = Toolchain(ociEdges())

-       safely(toolchain.path(Toolchain.Universe.Sjsir, OciImage))   // Unset: the component edge is missing
+       safely(toolchain.path(Toolchain.Universe.Sjsir, OciImage))   // Unset: the component edge is missing

=       safely(toolchain.path(Toolchain.Universe.Sjsir, OciImage))   // Unset: the component edge is missing
