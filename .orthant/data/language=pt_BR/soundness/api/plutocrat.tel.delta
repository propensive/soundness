-         import soundness.*
+         import soundness.*

-         import strategies.throwUnsafely
+         import strategies.throwUnsafely

-         Isin(t"GB00BH4HKS39").countryCode   // t"GB"
+         Isin(t"GB00BH4HKS39").countryCode   // t"GB"

=         Isin(t"GB00BH4HKS39").countryCode   // t"GB"
