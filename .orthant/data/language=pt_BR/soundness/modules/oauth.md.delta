-                   url"https://issuer.example/authorize", url"https://app.example/callback")
+                   url"https://issuer.example/authorize", url"https://app.example/callback")

- val pkce = Pkce()
+ val pkce = Pkce()

- val state = t"a7f3c9"
+ val state = t"a7f3c9"

- val destination = flow.authorizationUrl(List(t"read"), state, pkce)
+ val destination = flow.authorizationUrl(List(t"read"), state, pkce)

- def callback(code: Text): Authorization =
+ def callback(code: Text): Authorization =

-   flow.exchangeCode(code, pkce)
+   flow.exchangeCode(code, pkce)

=   flow.exchangeCode(code, pkce)
