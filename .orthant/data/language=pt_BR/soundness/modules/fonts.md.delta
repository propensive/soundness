+ val font: Sfnt = Sfnt(t"/fonts/text.ttf".as[Path on Classpath])

- val outlines: Text = font match
+ val outlines: Text = font match

-   case truetype: Truetype => t"TrueType outlines"
+   case truetype: Truetype => t"TrueType outlines"

-   case opentype: Opentype => t"PostScript outlines"
+   case opentype: Opentype => t"PostScript outlines"

