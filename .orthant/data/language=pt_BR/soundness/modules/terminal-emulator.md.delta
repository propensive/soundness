+ ##

- val titled = pty.consume(t"$esc]0;My application${7.toChar}$esc[?25l")
+ val titled = pty.consume(t"$esc]0;My application${7.toChar}$esc[?25l")

- Out.println(titled.state.title.inspect)
+ Out.println(titled.state.title.inspect)

