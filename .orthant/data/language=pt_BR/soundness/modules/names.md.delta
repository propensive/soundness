- Out.println(capture[Name.Error](Name[Tag](t"v1.0")).message.show)
+ Out.println(capture[Name.Error](Name[Tag](t"v1.0")).message.show)

= Out.println(capture[Name.Error](Name[Tag](t"v1.0")).message.show)
