+ case class Person(name: Text, @ident email: Text)

- case class Speech(speaker: Person, @ident @primary line: Long)
+ case class Speech(speaker: Person, @ident @primary line: Long)

- @number(10)
+ @number(10)

- case class Play(title: Text)
+ case class Play(title: Text)

= case class Play(title: Text)
- ```
+ ```

