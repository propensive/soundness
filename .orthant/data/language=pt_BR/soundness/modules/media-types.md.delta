-     expanse.size >= 4 && expanse.read(expanse.size - 4, 4).utf8 == t"DONE"
+     expanse.size >= 4 && expanse.read(expanse.size - 4, 4).utf8 == t"DONE"

=     expanse.size >= 4 && expanse.read(expanse.size - 4, 4).utf8 == t"DONE"
