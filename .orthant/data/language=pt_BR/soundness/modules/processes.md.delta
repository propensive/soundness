- sh"head -c 2".pty(termios = Termios.raw).session: terminal ?=>
+ sh"head -c 2".pty(termios = Termios.raw).session: terminal ?=>

-   t"hi".writeTo(terminal)
+   t"hi".writeTo(terminal)

-   val canonical: Boolean = terminal.mode.canonical
+   val canonical: Boolean = terminal.mode.canonical

-   terminal.mode = Termios.cooked
+   terminal.mode = Termios.cooked

-   terminal.text()
+   terminal.text()

=   terminal.text()
