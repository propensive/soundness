+   import mixing.proportionalMixing

-   val mixture = 5*WebColors.Red + 3*WebColors.Yellow
+   val mixture = 5*WebColors.Red + 3*WebColors.Yellow

-   Out.println(mixture.to[Srgb].inspect)
