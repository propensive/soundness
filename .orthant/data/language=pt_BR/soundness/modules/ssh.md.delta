+ val writer = Wire.Writer()

- writer.text(t"ssh-userauth")
+ writer.text(t"ssh-userauth")

- writer.names(List(t"curve25519-sha256", t"ecdh-sha2-nistp256"))
+ writer.names(List(t"curve25519-sha256", t"ecdh-sha2-nistp256"))

- val name: Text = Wire.Reader(writer.data).text()
+ val name: Text = Wire.Reader(writer.data).text()

= val name: Text = Wire.Reader(writer.data).text()
- ```
+ ```

