-   val first = async(fetch(urlA))
+   val first = async(fetch(urlA))

-   val second = async(fetch(urlB))
+   val second = async(fetch(urlB))

-   (first.await(), second.await())
+   (first.await(), second.await())

=   (first.await(), second.await())
