% 2 1 0 0ed5e491ffd8cc3212c246bb3b1b1633

% 0 1 0 0877360e20676ed600ff377f037c7fa9

% 1 1 0 02c8a01cbe20fc20176e06dd185f00f0

% 0 1 0 0001b5d1a6354b0c08c163a90a02c449

