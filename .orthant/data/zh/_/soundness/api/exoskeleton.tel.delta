% 8 1 0 045a6a10ec41de87025ea7bf2a2aaabb

% 9 1 0 17fd0a124c937129028e730b5cd5fc59

% 10 1 0 150ee44df4e48f340b1f07b8a72e4c9d

% 11 1 0 0a5db5467188dd320ca4c50c2a5c1be2

% 0 1 0 01cf9e5b2515caff1d727e6dca9f7d04

% 0 1 0 197b6b4607eaa90d1f1df3049cccef1d

% 1 1 0 0e875eadd78f2cff10aef6af484ac722

% 1 1 0 1a331274a049f3c30a40d1b06ca1ccb9

% 1 1 0 083aadb6ef974a8e131ff7cb6f2eb823

