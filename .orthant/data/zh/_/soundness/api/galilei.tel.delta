% 0 1 0 1274e6020264fd350e553d3726db9596

% 2 1 0 0fac70b5cae8c6280b47ce7e50803e4f

% 0 1 0 0b3fddc1e4689ae21a1d925b8cb35111

% 0 1 0 0b12c6608451c325112e7228ff34e215

