% 3 1 0 0c6ab1d144eb15361232c80f63b8c58b

% 4 1 0 0a91e5e73444beec17bbd2c737fcefc7

% 5 1 0 15e6ac16d50b62ed033d8ae48f446ba2

% 6 1 0 01495440d730147103391db13461db64

% 0 1 0 1a19e8296eed8f93182828a84905eb72

