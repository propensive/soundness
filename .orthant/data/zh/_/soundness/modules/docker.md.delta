% 0 1 0 18f198477c66980b0c5c67824bb737e0

% 1 1 0 1ee507d06f90141012d537878af43a68

@ 0 1 0 09d718fa67c4e3ec1ac7236ee0a38693
+ 以下是针对每种资源的方法：

% 2 1 0 00811dbd65915c451e2ee4d3afd911ba

@ 0 6 0 1dcdec709e18a92b056653c9a4552e20
+ column  资源
+ column  列出
+ column  检视
+ column  创建
+ column  删除
+ row  容器  `containers()`  `container(id)`  `createContainer(container)`  `deleteContainer(id)`

% 1 1 0 1d9b1e7869f6de2c1244959fdee92b67

@ 0 1 0 0941427d4ffcd2e40bab2679edfe1c40
+   cell  命名空间

% 0 1 0 15e1e7a47b291daf1991a32791ae16bb

% 1 1 0 0e77f1e16c0240a11b2a518ed6da2234

% 0 1 0 1fd8c6826921490e1062e902bf6a2828

% 0 1 0 1f5f184e994f521c1ebe9b1a169ed04c

% 1 1 0 1ce599b2741af9b21ecc4d65c4e67944

@ 0 1 0 05d4acaf789e196f128d8be58008ca33
+   cell  镜像

% 0 1 0 003d0b724c00c847133fdc7ab35670fe

