@ 0 1 0 066462476b47858e02769d89e912a666
+ # 从 HTTP 响应暂存升级

@ 0 3 0 0b87a2461c9c24701557e09653b4371c
+ 升级可以从任何字节源暂存。HTTP 响应就是一个字节源，因此获取发布版本并暂存它只需一个表达式，无需临时文件，也无需手工复制流。

% 0 1 0 12705ff5e291290d17fbc8389d59ef4a

% 0 1 0 1a979ed47beed0ac17e21ce8357554bb

% 1 1 0 1fd89d0a41d68ae00a7c626c69803bc1

@ 0 1 0 08e9366e675641ea14d5d763ab0436d2
+   label 获取发布版本

% 1 1 0 002ebaa5c89139a10d11c48b415a5fbb

% 2 1 0 0c83ed771e8f1c9111567053896b1b8f

% 3 1 0 1a8d2dfc0c241b280574f9b6f9fed7ec

% 4 1 0 0039fc43b5bbc76d168ab8245433cbf3

% 0 1 0 1b656b2eb005f51813324159a1187719

% 1 1 0 1c7a64afaee5025315a647576bab8f09

@ 0 2 0 0d30a9356d360d3607247bf8abe99815
+   label 然后暂存
+   highlight Upgrade.stage  由启动器在下一次调用时验证

% 1 1 0 0d52b6ccb7c5d7e71aa975b4403b5609

