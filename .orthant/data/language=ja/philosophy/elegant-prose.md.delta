+   val server = SocketServer(8080).handle:

-     request.target match
+     request.target match

-       case t"/"       => Http.Response(Http.Ok)(homePage)
+       case t"/"       => Http.Response(Http.Ok)(homePage)

-       case t"/status" => Http.Response(Http.Ok)(t"OK")
+       case t"/status" => Http.Response(Http.Ok)(t"OK")

-       case _          => Http.Response(Http.NotFound)(t"No such page")
+       case _          => Http.Response(Http.NotFound)(t"No such page")

=       case _          => Http.Response(Http.NotFound)(t"No such page")
