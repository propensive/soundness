+     bytes.read[Person in Cbor]                             // Person(t"Hal", 36)

-     Cbor.unseal(encoded).show                              // t"{\"name\": \"Hal\", \"age\": 36}"
+     Cbor.unseal(encoded).show                              // t"{\"name\": \"Hal\", \"age\": 36}"

=     Cbor.unseal(encoded).show                              // t"{\"name\": \"Hal\", \"age\": 36}"
