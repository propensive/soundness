-       case h"<li>one</li>" => 1
+       case h"<li>one</li>" => 1

-       case h"<li>$value</li>" => value match
+       case h"<li>$value</li>" => value match

-         case Html.Text("two") => 2
+         case Html.Text("two") => 2

-         case _                => 0
+         case _                => 0

-       case _ => 0
