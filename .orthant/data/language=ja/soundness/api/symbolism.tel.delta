+     import soundness.*

-     1 + 2          // 3
+     1 + 2          // 3

-     1 + 2.5        // 3.5, through `Addable.int2`
+     1 + 2.5        // 3.5, through `Addable.int2`

-     List(1, 2) + List(3)
+     List(1, 2) + List(3)

=     List(1, 2) + List(3)
-     ```
+     ```

