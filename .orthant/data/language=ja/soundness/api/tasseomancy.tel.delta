+       Kalman.smooth(List(5.0, 5.0, 5.0, 5.0), 4.0)     // List(5.0, 5.0, 5.0, 5.0)

-       Kalman.smooth(List(10.0, 10.0, 20.0, 10.0, 10.0), 4.0).at(Ter).or(0.0)   // between 10.0 and 20.0
+       Kalman.smooth(List(10.0, 10.0, 20.0, 10.0, 10.0), 4.0).at(Ter).or(0.0)   // between 10.0 and 20.0

=       Kalman.smooth(List(10.0, 10.0, 20.0, 10.0, 10.0), 4.0).at(Ter).or(0.0)   // between 10.0 and 20.0
-       ```
