+       import soundness.*

-       summon[FontMetric].width(t"abcde").value   // 3.0: six tenths of an em per character
+       summon[FontMetric].width(t"abcde").value   // 3.0: six tenths of an em per character

=       summon[FontMetric].width(t"abcde").value   // 3.0: six tenths of an em per character
