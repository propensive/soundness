+       import soundness.*

-       import rudiments.Scroll
+       import rudiments.Scroll

-       val offsets = Scroll[Int]()
+       val offsets = Scroll[Int]()

-       offsets.append(0)
+       offsets.append(0)

-       offsets.append(14)
+       offsets.append(14)

-       offsets.last             // 14
+       offsets.last             // 14

-       offsets(1) = 15
+       offsets(1) = 15

-       offsets.freeze.to[List]  // List(0, 15)
+       offsets.freeze.to[List]  // List(0, 15)

-       offsets.clear()
+       offsets.clear()

=       offsets.clear()
