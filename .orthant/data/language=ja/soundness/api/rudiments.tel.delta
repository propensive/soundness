-     import soundness.*
+     import soundness.*

-     val a: Map[Int, List[Text]] = Map(1 -> List(t"one"), 2 -> List(t"two"))
+     val a: Map[Int, List[Text]] = Map(1 -> List(t"one"), 2 -> List(t"two"))

-     val b: Map[Int, List[Text]] = Map(2 -> List(t"deux"))
+     val b: Map[Int, List[Text]] = Map(2 -> List(t"deux"))

-     a.collate(b)(_ + _)   // Map(1 -> List(t"one"), 2 -> List(t"two", t"deux"))
+     a.collate(b)(_ + _)   // Map(1 -> List(t"one"), 2 -> List(t"two", t"deux"))

=     a.collate(b)(_ + _)   // Map(1 -> List(t"one"), 2 -> List(t"two", t"deux"))
