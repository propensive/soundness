-     import soundness.*
+     import soundness.*

-     def normalize(text: Text, lower: Boolean): Text = text.when(lower)(_.lower)
+     def normalize(text: Text, lower: Boolean): Text = text.when(lower)(_.lower)

=     def normalize(text: Text, lower: Boolean): Text = text.when(lower)(_.lower)
