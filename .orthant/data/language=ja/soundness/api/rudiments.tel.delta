+     frame

-       label An unproven list: head is Optional
+       label 証明のないリスト。head は Optional

=       label An unproven list: head is Optional
-       code
+       code

-           val xs: List[Int] = List(3, 1, 2)
+           val xs: List[Int] = List(3, 1, 2)

-           xs.head                          // Optional[Int]
+           xs.head                          // Optional[Int]

=           xs.head                          // Optional[Int]
-     frame
+     frame

-       label A literal proves itself: head is bare
+       label リテラルは自らを証明する。head はそのまま

=       label A literal proves itself: head is bare
-       code
+       code

-           List(3, 1, 2).head               // Int
+           List(3, 1, 2).head               // Int

=           List(3, 1, 2).head               // Int
-     frame
+     frame

-       label A checked value carries the proof into a block
+       label 検査済みの値は証明をブロックの中へ運ぶ

=       label A checked value carries the proof into a block
-       code
+       code

-           import rudiments.occupied
+           import rudiments.occupied

-           xs.occupied.let(_.head + 1)      // Optional[Int], the addition total inside
+           xs.occupied.let(_.head + 1)      // Optional[Int], the addition total inside

=           xs.occupied.let(_.head + 1)      // Optional[Int], the addition total inside
-     ##
+     ##

=           xs.occupied.let(_.head + 1)      // Optional[Int], the addition total inside
=     ##
