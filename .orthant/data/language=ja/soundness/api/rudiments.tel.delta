-       import soundness.*
+       import soundness.*

-       val depth = Scoped[Int]()
+       val depth = Scoped[Int]()

-       depth(1):
+       depth(1):

-         depth(2)(depth())     // 2
+         depth(2)(depth())     // 2

-         depth()               // 1
+         depth()               // 1

-       depth()                 // Unset
+       depth()                 // Unset

=       depth()                 // Unset
-       ```
+       ```

