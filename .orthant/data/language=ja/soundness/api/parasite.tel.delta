-       supervise:
+       supervise:

-         val parent = async:
+         val parent = async:

-           async:
+           async:

-             snooze(0.05*Second)
+             snooze(0.05*Second)

-             done = true
+             done = true

-           t"returned"
+           t"returned"

-         parent.await()   // t"returned", once the child has finished under awaitProbate
