=       import xmlSchemas.freeformXmlSchema
-       import dynamicAccess.dynamicXml
+       import dynamicAccess.dynamicXml

-       val doc: Xml = t"<library><book id=\"1\"><title>Hamlet</title></book></library>".read[Xml]
+       val doc: Xml = t"<library><book id=\"1\"><title>Hamlet</title></book></library>".read[Xml]

-       doc.book().title().as[Text]            // t"Hamlet"
+       doc.book().title().as[Text]            // t"Hamlet"

-       doc.book(Prim).show                    // t"<book id=\"1\"><title>Hamlet</title></book>"
+       doc.book(Prim).show                    // t"<book id=\"1\"><title>Hamlet</title></book>"

-       doc.selectText(xp"//book/@id")         // t"1"
+       doc.selectText(xp"//book/@id")         // t"1"

-       x"<book><title>Hamlet</title></book>" == doc.book()
+       x"<book><title>Hamlet</title></book>" == doc.book()

=       x"<book><title>Hamlet</title></book>" == doc.book()
