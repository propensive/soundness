+       Stop(0.25, WebColors.White).in[Xml].show   // <stop offset="0.25" stop-color="#ffffff"/>

=       Stop(0.25, WebColors.White).in[Xml].show   // <stop offset="0.25" stop-color="#ffffff"/>
