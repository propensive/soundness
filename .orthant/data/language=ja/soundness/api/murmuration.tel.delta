-     ages.remap { (name, age) => name }    // List(t"Romeo", t"Juliet")
+     ages.remap { (name, age) => name }    // List(t"Romeo", t"Juliet")

-     t"hello".filter(_ != 'l')             // t"heo"
+     t"hello".filter(_ != 'l')             // t"heo"

