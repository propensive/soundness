-       ForeignLibrary.register
+       ForeignLibrary.register

-         ( t"/opt/homebrew/opt/openssl@3/lib/libcrypto.dylib",
+         ( t"/opt/homebrew/opt/openssl@3/lib/libcrypto.dylib",

-           t"libcrypto.so.3",
+           t"libcrypto.so.3",

-           t"libcrypto.dylib" )
+           t"libcrypto.dylib" )

=           t"libcrypto.dylib" )
