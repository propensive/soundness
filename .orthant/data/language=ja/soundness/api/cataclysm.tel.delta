-           Css.Syntax.Matcher.check(grammar, t"1px, 2px, 3px")     // Css.Outcome.Valid
+           Css.Syntax.Matcher.check(grammar, t"1px, 2px, 3px")     // Css.Outcome.Valid

-           Css.Syntax.Matcher.check(grammar, t"1px 2px")           // Css.Outcome.Invalid
