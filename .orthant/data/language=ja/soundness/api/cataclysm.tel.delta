+       Css.Syntax.Matcher.check(width, t"4px")                // Css.Outcome.Valid

-       Css.Syntax.Matcher.check(width, t"wide")               // Css.Outcome.Invalid
+       Css.Syntax.Matcher.check(width, t"wide")               // Css.Outcome.Invalid

