=       ```scala
-       import soundness.*
+       import soundness.*

-       val buffer = Array.allocate[Int](2)
+       val buffer = Array.allocate[Int](2)

-       buffer(0) = 1
+       buffer(0) = 1

-       buffer(1) = 2
+       buffer(1) = 2

-       Array.freeze(buffer).to[List]   // List(1, 2)
+       Array.freeze(buffer).to[List]   // List(1, 2)

=       Array.freeze(buffer).to[List]   // List(1, 2)
