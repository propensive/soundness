-       import soundness.*
+       import soundness.*

-       Chain.continually(42) match
+       Chain.continually(42) match

-         case head #:: _ => head   // 42
+         case head #:: _ => head   // 42

=         case head #:: _ => head   // 42
-       ```
+       ```

