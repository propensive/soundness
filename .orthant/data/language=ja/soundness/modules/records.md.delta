+ val name: Text = tuple.name

- val (first, second, third) = tuple
+ val (first, second, third) = tuple

- val plain: (Text, Optional[Int], List[(weight: Double)]) = tuple.toTuple
+ val plain: (Text, Optional[Int], List[(weight: Double)]) = tuple.toTuple

