- List(2, 3, 4, 5).each(key => cache(key)(expensiveLookup(key)))
+ List(2, 3, 4, 5).each(key => cache(key)(expensiveLookup(key)))

- Out.println(cache.contains(1).inspect)
+ Out.println(cache.contains(1).inspect)

= Out.println(cache.contains(1).inspect)
- Out.println(cache.contains(5).inspect)
+ Out.println(cache.contains(5).inspect)

