+ case class Stat(name: Text, count: Int, note: Optional[Text])

- given statParsable: (Stat is Dsv.Parsable) = Dsv.Parsable.derived
+ given statParsable: (Stat is Dsv.Parsable) = Dsv.Parsable.derived

= given statParsable: (Stat is Dsv.Parsable) = Dsv.Parsable.derived
- ```
