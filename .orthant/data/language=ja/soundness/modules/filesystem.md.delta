= ##
- file.write(t"Hello world")
+ file.write(t"Hello world")

- val middle = file.open[Ram](): ram ?=>
+ val middle = file.open[Ram](): ram ?=>

-   ram(2, 3)
+   ram(2, 3)

- file.open[Ram](Read & Write): ram ?=>
+ file.open[Ram](Read & Write): ram ?=>

-   ram(3L) = t"XYZ".in[Data]
+   ram(3L) = t"XYZ".in[Data]

- Out.println(middle.utf8)
+ Out.println(middle.utf8)

= Out.println(middle.utf8)
- Out.println(file.read[Text])
+ Out.println(file.read[Text])

