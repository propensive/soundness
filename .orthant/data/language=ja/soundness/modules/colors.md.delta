+   import mixing.multiplyMixing

-   Out.println((1*WebColors.Yellow + 1*WebColors.Cyan).to[Srgb].inspect)
+   Out.println((1*WebColors.Yellow + 1*WebColors.Cyan).to[Srgb].inspect)

