+ Out.println((Eur(3.01) + Eur(0.02)).show)

- Out.println((Eur(3.01)*3.0).show)
+ Out.println((Eur(3.01)*3.0).show)

- Out.println((Eur(3.01)/3).show)
+ Out.println((Eur(3.01)/3).show)

- Out.println((-Eur(1.99)).show)
+ Out.println((-Eur(1.99)).show)

- Out.println((Eur(1.01) >= Eur(1.01)).inspect)
