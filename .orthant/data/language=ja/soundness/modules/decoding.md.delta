- Out.println(summon[Decodable.Absence in Text].strict.inspect)
+ Out.println(summon[Decodable.Absence in Text].strict.inspect)

- Out.println(summon[Decodable.Nullity in Text].strict.inspect)
+ Out.println(summon[Decodable.Nullity in Text].strict.inspect)

- Out.println(summon[Decodable.Fault in Text].strict.inspect)
