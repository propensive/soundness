+ ##

- Out.println(leaf.verify(swarmKey.public).inspect)
+ Out.println(leaf.verify(swarmKey.public).inspect)

- Out.println(root.verify(swarmKey.public).inspect)
+ Out.println(root.verify(swarmKey.public).inspect)

- Out.println(leaf.verify(privateKey.public).inspect)
