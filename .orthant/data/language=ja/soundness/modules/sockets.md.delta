- val endpoint = ip"127.0.0.1" on Port[Tcp](8080)
+ val endpoint = ip"127.0.0.1" on Port[Tcp](8080)

- val greeting: Data = endpoint.session: connection ?=>
+ val greeting: Data = endpoint.session: connection ?=>

-   connection.send(Stream(t"hello".in[Data]))
+   connection.send(Stream(t"hello".in[Data]))

-   connection.source.memoize
