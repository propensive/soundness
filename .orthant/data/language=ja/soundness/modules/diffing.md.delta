-     Sequence(t"Macbeth", t"Malcolm", t"Macduff", t"Banquo") )
+     Sequence(t"Macbeth", t"Malcolm", t"Macduff", t"Banquo") )

=     Sequence(t"Macbeth", t"Malcolm", t"Macduff", t"Banquo") )
- ```
+ ```

