-   code
+   code

-       object Tests extends Suite(m"Parser tests"):
+       object Tests extends Suite(m"Parser tests"):

=       object Tests extends Suite(m"Parser tests"):
-         def run(): Unit =
+         def run(): Unit =

-           suite(m"Numbers"):
+           suite(m"Numbers"):

-             test(m"a decimal integer parses"):
+             test(m"a decimal integer parses"):

-               t"42".as[Int]
+               t"42".as[Int]

-             . assert(_ == 42)
+             . assert(_ == 42)

