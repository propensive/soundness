+ ```scala

- object Tests extends Suite("parser", m"Parser tests"):
+ object Tests extends Suite("parser", m"Parser tests"):

-   def main(arguments: scala.Array[String]): Unit = Suite.main(arguments, Tests)
+   def main(arguments: scala.Array[String]): Unit = Suite.main(arguments, Tests)

-   def run(): Unit = ()
+   def run(): Unit = ()

=   def run(): Unit = ()
