+ ```scala

- val split = t"""[1, 2, 3, 4]""".read[Json] match
+ val split = t"""[1, 2, 3, 4]""".read[Json] match

-   case j"""[$head, $tail*]""" => (head.as[Int], tail.as[List[Int]])
+   case j"""[$head, $tail*]""" => (head.as[Int], tail.as[List[Int]])

-   case _                      => (0, Nil)
+   case _                      => (0, Nil)

=   case _                      => (0, Nil)
- ```
+ ```

=   case _                      => (0, Nil)
= ```
