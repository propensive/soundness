- Out.println(store(digest).let(_.utf8).or(t"missing"))
+ Out.println(store(digest).let(_.utf8).or(t"missing"))

- Out.println(store.has(digest).inspect)
+ Out.println(store.has(digest).inspect)

- Out.println(store.missing(List(digest)).inspect)
