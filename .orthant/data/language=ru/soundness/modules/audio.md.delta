- val aiff: Data = audio.to[Aiff].read[Data]
+ val aiff: Data = audio.to[Aiff].read[Data]

- Out.println(aiff.read[Audio in Aiff].frames.show)
+ Out.println(aiff.read[Audio in Aiff].frames.show)

- Out.println(aiff.read[Audio in Aiff](0, 2).show)
+ Out.println(aiff.read[Audio in Aiff](0, 2).show)

= Out.println(aiff.read[Audio in Aiff](0, 2).show)
