+ val hamlet = t"name Hamlet\nage 30\n".read[Tel].as[Person]

- val horatio = t"name Horatio\nage 32\n".read[Person in Tel]
+ val horatio = t"name Horatio\nage 32\n".read[Person in Tel]

= val horatio = t"name Horatio\nage 32\n".read[Person in Tel]
