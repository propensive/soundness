- val record = ContactRecords.record(t"name Hamlet\nage 30\n".read[Tel])
+ val record = ContactRecords.record(t"name Hamlet\nage 30\n".read[Tel])

- val recordName: Text = record.name
+ val recordName: Text = record.name

- val recordAge: Int = record.age
+ val recordAge: Int = record.age

= val recordAge: Int = record.age
- ```
