+ ```scala

- val matched = contact match
+ val matched = contact match

-   case tel"name $name" => name.as[Text]
+   case tel"name $name" => name.as[Text]

-   case _               => t"anonymous"
+   case _               => t"anonymous"

=   case _               => t"anonymous"
- ```
+ ```

=   case _               => t"anonymous"
= ```
