+ val hamlet = t"{name: Hamlet, age: 30}".read[Yaml].as[Person]

- val horatio = t"name: Horatio\nage: 32".read[Person in Yaml]
+ val horatio = t"name: Horatio\nage: 32".read[Person in Yaml]

= val horatio = t"name: Horatio\nage: 32".read[Person in Yaml]
