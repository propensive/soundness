+ val claude = Anthropic(t"claude-sonnet-4-5", key).prompted(t"Be terse.").limit(1024)

- val gpt = OpenAI(t"gpt-5", t"sk-…").warmth(0.2)
+ val gpt = OpenAI(t"gpt-5", t"sk-…").warmth(0.2)

- val gemini = Gemini(t"gemini-2.5-pro", t"AIza…")
+ val gemini = Gemini(t"gemini-2.5-pro", t"AIza…")

