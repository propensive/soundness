+ import decodables.durationJsonDecodable

= import decodables.durationJsonDecodable
- ```
+ ```

= import decodables.durationJsonDecodable
= ```
=
- ```scala fuel
+ ```scala fuel

= import decodables.durationJsonDecodable
= ```
=
= ```scala fuel
- run
+ run

= import decodables.durationJsonDecodable
= ```
=
= ```scala fuel
= run
- ##
+ ##

- Out.println(Instant(1700000000000L).in[Json].show)
+ Out.println(Instant(1700000000000L).in[Json].show)

