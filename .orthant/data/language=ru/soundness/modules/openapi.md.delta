-   Credential(Auth.Basic(t"curator", t"…"))
+   Credential(Auth.Basic(t"curator", t"…"))

- val museum = Api(cp"/openapi/redocly/museum.yaml")
+ val museum = Api(cp"/openapi/redocly/museum.yaml")

- val ticket: Raster in Png = museum.tickets(t"a1").qr.get.call()
+ val ticket: Raster in Png = museum.tickets(t"a1").qr.get.call()

