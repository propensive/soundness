-     case Git.Head.Attached(branch, tip) => Out.println(t"on $branch")
+     case Git.Head.Attached(branch, tip) => Out.println(t"on $branch")

-     case Git.Head.Detached(at)          => Out.println(t"detached at $at")
+     case Git.Head.Detached(at)          => Out.println(t"detached at $at")

=     case Git.Head.Detached(at)          => Out.println(t"detached at $at")
