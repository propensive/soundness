-   Out.println(worktree.merge(Git.Branch(t"feature"), worktree.head(), ff = FastForward.Only).inspect)
+   Out.println(worktree.merge(Git.Branch(t"feature"), worktree.head(), ff = FastForward.Only).inspect)

=   Out.println(worktree.merge(Git.Branch(t"feature"), worktree.head(), ff = FastForward.Only).inspect)
