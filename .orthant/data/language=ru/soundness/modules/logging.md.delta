+ import pathInterfaces.pathOnLinux

- import temporaryDirectories.javaBaseTemporaryDirectory
+ import temporaryDirectories.javaBaseTemporaryDirectory

- val logFile = temporaryDirectory[Path on Linux] / "logging" / "app.log"
+ val logFile = temporaryDirectory[Path on Linux] / "logging" / "app.log"

- logFile.create[File](CreateFlag.Parents)
+ logFile.create[File](CreateFlag.Parents)

