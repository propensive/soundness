+ ##

- locally:
+ locally:

-   given environment: Environment = name => if name == t"EDITOR" then t"vim" else Unset
+   given environment: Environment = name => if name == t"EDITOR" then t"vim" else Unset

-   Out.println(Environment.editor[Text])
