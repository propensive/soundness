+ row  `affirmations.onOffAffirmation`  `on`  `off`

- row  `affirmations.trueFalseAffirmation`  `true`  `false`
+ row  `affirmations.trueFalseAffirmation`  `true`  `false`

- row  `affirmations.oneZeroAffirmation`  `1`  `0`
