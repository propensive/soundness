+ ##

- Out.println(element.namespace.inspect)
+ Out.println(element.namespace.inspect)

- Out.println(element.localName.inspect)
+ Out.println(element.localName.inspect)

- Out.println(element.qualified.inspect)
+ Out.println(element.qualified.inspect)

= Out.println(element.qualified.inspect)
