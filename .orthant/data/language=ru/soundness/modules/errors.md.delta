- ```scala
+ ```scala

- def describe(port: Int): Text = attempt[PortError](connect(port)) match
+ def describe(port: Int): Text = attempt[PortError](connect(port)) match

-   case Attempt.Success(connection) => t"connected on port ${connection.port}"
+   case Attempt.Success(connection) => t"connected on port ${connection.port}"

-   case Attempt.Failure(error)      => t"failed: ${error.message}"
+   case Attempt.Failure(error)      => t"failed: ${error.message}"

