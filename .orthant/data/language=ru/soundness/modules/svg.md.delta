+ ```scala

- val drawing = Svg(50, 50, figures = List(plus))
+ val drawing = Svg(50, 50, figures = List(plus))

= val drawing = Svg(50, 50, figures = List(plus))
- ```
+ ```

= val drawing = Svg(50, 50, figures = List(plus))
= ```
