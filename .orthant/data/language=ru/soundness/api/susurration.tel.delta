+       config.resolve(t"dev.example.com").user   // t"horatio"

-       config.resolve(t"git.example.com").user   // t"ophelia": the negation excludes it from the second block
+       config.resolve(t"git.example.com").user   // t"ophelia": the negation excludes it from the second block

-       config.resolve(t"other").hostName         // t"other.lan"
+       config.resolve(t"other").hostName         // t"other.lan"

