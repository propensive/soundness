-       object Ratio:
+       object Ratio:

-         given quotient: Ratio is Quotient:
+         given quotient: Ratio is Quotient:

-           type Topic = Long
+           type Topic = Long

-           type Transport = Long
+           type Transport = Long

-           def decompose(ratio: Ratio): Option[(Long, Long)] = Some((ratio.over, ratio.under))
+           def decompose(ratio: Ratio): Option[(Long, Long)] = Some((ratio.over, ratio.under))

-       Ratio(16, 9) match
+       Ratio(16, 9) match

