+     import soundness.*

-     val page = Roff
+     val page = Roff

-       ( t"greet", 1, t"2026-08-17", t"greet 1.0", t"User Commands",
+       ( t"greet", 1, t"2026-08-17", t"greet 1.0", t"User Commands",

-         List
+         List

-           ( Roff.Block.Section
+           ( Roff.Block.Section

-               ( t"Name", List(Roff.Block.Paragraph(Roff.Inline.plain(t"greet - say hello"))) ),
+               ( t"Name", List(Roff.Block.Paragraph(Roff.Inline.plain(t"greet - say hello"))) ),

-             Roff.Block.Section
+             Roff.Block.Section

-               ( t"Options",
+               ( t"Options",

-                 List
+                 List

-                   ( Roff.Block.Tagged
+                   ( Roff.Block.Tagged

-                       ( List(Roff.Inline.bold(t"--loud")),
+                       ( List(Roff.Inline.bold(t"--loud")),

-                         Roff.Inline.plain(t"Greet in capital letters.") ) ) ) ) )
+                         Roff.Inline.plain(t"Greet in capital letters.") ) ) ) ) )

-     page.serialize
+     page.serialize

-     // .TH "GREET" "1" "2026-08-17" "greet 1.0" "User Commands"
+     // .TH "GREET" "1" "2026-08-17" "greet 1.0" "User Commands"

-     // .SH "Name"
+     // .SH "Name"

-     // greet \- say hello
+     // greet \- say hello

-     // .SH "Options"
+     // .SH "Options"

-     // .TP
