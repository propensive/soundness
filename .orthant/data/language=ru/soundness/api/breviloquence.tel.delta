+         given (Point is Cbor.Parsable) = Cbor.Parsable: reader =>

-           var x = 0
+           var x = 0

-           var y = 0
+           var y = 0

-           val count = reader.openMap()
+           val count = reader.openMap()

-           var remaining = count
+           var remaining = count

-           while remaining != 0 && !(count < 0 && reader.breakEnd()) do
+           while remaining != 0 && !(count < 0 && reader.breakEnd()) do

-             reader.keyName() match
+             reader.keyName() match

-               case "x"  => x = reader.int()
+               case "x"  => x = reader.int()

-               case "y"  => y = reader.int()
+               case "y"  => y = reader.int()

-               case _    => reader.skipValue()
+               case _    => reader.skipValue()

-             remaining -= 1
+             remaining -= 1

-           Point(x, y)
+           Point(x, y)

