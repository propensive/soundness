-     import soundness.*
+     import soundness.*

=     import soundness.*
=
-     t"/home/work/docs" match
+     t"/home/work/docs" match

-       case g"/$home/$work/docs" => (home, work)   // (t"home", t"work")
+       case g"/$home/$work/docs" => (home, work)   // (t"home", t"work")

-       case _                    => (t"", t"")
+       case _                    => (t"", t"")

=       case _                    => (t"", t"")
=
-     t"/home/work/docs" match
+     t"/home/work/docs" match

-       case g"/$home/**" => home   // t"home"
+       case g"/$home/**" => home   // t"home"

-       case _            => t""
+       case _            => t""

-     t"file.txt" match
+     t"file.txt" match

-       case g"*.txt" => true
+       case g"*.txt" => true

-       case _        => false
+       case _        => false

=       case _        => false
-     ```
+     ```

-     A glob and a regular expression which translate to the same pattern are equal —
-     `g".local/*" == r"\.local/[^/\\]*"` — and `Glob.parse(text).regex` shows the translation.
-     A glob is total: every text is a glob, so `g"…"` never fails to compile.
+     Глоб и регулярное выражение, которые переводятся в один и тот же образец, равны —
+     `g".local/*" == r"\.local/[^/\\]*"`, — а `Glob.parse(text).regex` показывает перевод.
+     Глоб тотален: каждый текст — глоб, так что `g"…"` никогда не вызывает ошибку компиляции.

