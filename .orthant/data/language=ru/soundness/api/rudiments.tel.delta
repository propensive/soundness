-     ages.confine(t"Hamlet").let(ages(_))   // Optional[Int]: 30
+     ages.confine(t"Hamlet").let(ages(_))   // Optional[Int]: 30

=     ages.confine(t"Hamlet").let(ages(_))   // Optional[Int]: 30
