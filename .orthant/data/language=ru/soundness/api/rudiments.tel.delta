-     import soundness.*
+     import soundness.*

-     t"Hello world".segment(Quin thru Sept)   // t"o w"
+     t"Hello world".segment(Quin thru Sept)   // t"o w"

=     t"Hello world".segment(Quin thru Sept)   // t"o w"
