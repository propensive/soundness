-         txt(t"FP")           // t"abc"
+         txt(t"FP")           // t"abc"

-         txt(t"flag")         // Unset, though present
+         txt(t"flag")         // Unset, though present

-         txt.has(t"flag")     // true
+         txt.has(t"flag")     // true

-         txt.strings          // List(t"fp=abc", t"flag")
