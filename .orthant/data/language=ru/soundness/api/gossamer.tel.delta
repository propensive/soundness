-     import soundness.*
+     import soundness.*

-     val name = a"world"
+     val name = a"world"

-     a"hello $name".bytes.length   // 11
+     a"hello $name".bytes.length   // 11

-     a"hello café"                 // does not compile
+     a"hello café"                 // does not compile

=     a"hello café"                 // does not compile
-     ```
+     ```

