+     import soundness.*

-     val span: Span = Span.line(3.z, 7.z, 4)
+     val span: Span = Span.line(3.z, 7.z, 4)

-     span.mode          // Span.Mode.Line
+     span.mode          // Span.Mode.Line

-     span.startLine     // 3.z
+     span.startLine     // 3.z

-     span.endColumn     // 11.z
+     span.endColumn     // 11.z

-     span.length        // 4
+     span.length        // 4

-     span.offset        // Unset: a line-mode span carries no offset
+     span.offset        // Unset: a line-mode span carries no offset

=     span.offset        // Unset: a line-mode span carries no offset
