tel 1.0

# Checked literals in Soundness: a presentation, shown with
#
#   fuel present doc/talks/literals/literals.tel --transcript doc/talks/literals/literals.md
#
# Each state has an id, a slide's on its line and a frame's on its own, which the transcript
# cues. A slide of code shows the code alone: what is said of it is in the transcript. Each
# frame holds one example, or one more step of the example before it; a step which edits
# the code before it is `typed`.
title  Checked literals
style  ../soundness.css
script  ../soundness.js

slide
  markdown
      # Checked literals

      Exact handling in Soundness

slide overview
  markdown
      ## What follows

      - Literals for many types of value
      - Mistakes which do not compile
      - Substitutions which are typed
      - Construction at no cost
      - The same literals as patterns

slide golden-rules
  markdown
      ## Two golden rules

      1. Impossible states should be unrepresentable.
      2. Transitions between states should be total.

slide
  syntax scala
    compile
    frame runtime-parse
      code
          def read(text: Text): MediaType raises MediaType.Error =
            text.as[MediaType]
    frame must-handle
      typed
      code
          def read(text: Text): MediaType raises MediaType.Error =
            text.as[MediaType]

          val found = safely(read(t"text/plian"))
    frame literal-cannot-fail
      typed
      code
          def read(text: Text): MediaType raises MediaType.Error =
            text.as[MediaType]

          val found = safely(read(t"text/plian"))

          val plain: MediaType = media"text/plain"

slide exact-handling
  markdown
      ## Exact handling

      Handle every failure which is possible.

      Never handle a failure which is impossible.

