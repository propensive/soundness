slide
  syntax scala
    parse
    frame cost-literal
      code
          val item = h"<li>$name</li>"
    frame cost-reparsed
      code
          val item = Html.parse(t"<li>" + name + t"</li>")
    frame cost-constructed
      code
          val item = Html.Element
            ( "li", Attributes(), Array(Html.Text(name)) )
    frame cost-json
      code
          val json = j"""{"name": $name, "songs": 4}"""
    frame cost-json-constructed
      code
          val json = Json.ast:
            Json.Ast.obj
              ( Array("name", "songs"),
                Array(encode(name), Json.Ast(4)) )

slide
  syntax scala
    compile
    frame match-json
      code
          val play = j"""{"title": "Twelfth Night", "year": 1602,
                          "fools": ["Feste", "Fabian"]}"""

          val found = play match
            case j"""{"title": $title, $rest}""" => title
            case _ => j"{}"
    frame match-json-exact
      typed
      code
          val play = j"""{"title": "Twelfth Night", "year": 1602,
                          "fools": ["Feste", "Fabian"]}"""

          val found = play match
            case j"""{"year": 1602, $rest}""" => rest
            case _ => j"{}"
    frame match-json-array
      typed
      code
          val play = j"""{"title": "Twelfth Night", "year": 1602,
                          "fools": ["Feste", "Fabian"]}"""

          val found = play match
            case j"""{"fools": [$one, $more*], $rest}""" => one
            case _ => j"{}"

slide
  syntax scala
    compile
    frame match-xml
      code
          val play =
            x"""<play year="1602"><fool>Feste</fool></play>"""

          val year = play match
            case x"<play year=$year>$child</play>" => year
            case _ => t"unknown"
    frame match-xml-element
      typed
      code
          val play =
            x"""<play year="1602"><fool>Feste</fool></play>"""

          val count = play match
            case x"<play $attrs><$fool></play>" => attrs.size
            case _ => 0
    frame match-html
      code
          val fairies = h"<ul><li>Oberon</li></ul>"

          val single = fairies match
            case h"<ul>$item</ul>" => true
            case _ => false

slide
  syntax scala
    compile
    frame match-regex
      code
          val place: (Text, Text) = t"act 3 scene 12" match
            case r"act $act(\d) scene $scene(\d+)" => (act, scene)
            case _ => (t"", t"")
    frame match-regex-optional
      code
          val aside: Optional[Text] = t"Enter Viola aside" match
            case r"Enter [A-Z][a-z]+$aside( aside)?" => aside
            case _ => Unset
    frame match-regex-repeated
      code
          val digits: List[Char] = t"line 1602" match
            case r"line $digits\d+" => digits
            case _ => Nil

slide wrap-up
  markdown
      ## A checked literal is

      - **checked**, as the code compiles
      - **typed**, in what it takes and what it gives
      - **fast**, with nothing left to parse

      Handle every failure which is possible.

      Never handle a failure which is impossible.

slide
  syntax scala
    compile
    frame next-populated
      code
          val cast = List(t"Viola", t"Olivia", t"Feste")
          val lead: Text = cast.head
    frame next-optional
      typed
      code
          val cast = List(t"Viola", t"Olivia", t"Feste")
          val lead: Text = cast.head

          def first(cast: List[Text]): Optional[Text] = cast.head

