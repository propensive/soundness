slide
  syntax scala
    compile
    frame uuid-wrong
      errors show
      code
          val id = uuid"not-a-uuid"
    frame uuid-right
      typed
      code
          val id = uuid"7a0c2f5e-1b6d-4c3a-9e8f-2d4b6a8c0e1f"
    frame date-wrong
      errors show
      code
          val opening = ts"2024-02-30T19:30:00"
    frame date-right
      typed
      code
          val opening = ts"2024-02-29T19:30:00"
    frame isin-wrong
      errors show
      code
          val share = isin"GB00BH4HKS38"
    frame isin-right
      typed
      code
          val share = isin"GB00BH4HKS39"
    frame media-wrong
      errors show
      code
          val kind = media"text/plian"
    frame media-right
      typed
      code
          val kind = media"text/plain"
    frame port-wrong
      errors show
      code
          val port = tcp"70000"
    frame port-right
      typed
      code
          val port = tcp"7000"

