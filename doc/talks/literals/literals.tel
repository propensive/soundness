slide typed-substitutions
  markdown
      ## A substitution is a value

      It is never turned into a string first.

      `toString` is never called.

slide
  syntax scala
    compile
    frame text-shown
      code
          val name = t"Feste"
          val songs = 4

          val line = t"$name sings $songs songs"
    frame text-lute
      typed
      code
          val name = t"Feste"
          val songs = 4

          val line = t"$name sings $songs songs"

          class Lute
          val lute = Lute()
    frame text-rejected
      errors show
      typed
      code
          val name = t"Feste"
          val songs = 4

          val line = t"$name sings $songs songs"

          class Lute
          val lute = Lute()

          val wrong = t"$name plays the $lute"

