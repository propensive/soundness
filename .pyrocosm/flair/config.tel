tel 1.0

# Flair's configuration for Soundness: Consequent Style over every library, with the project's
# unsafety gate, and the constructs the codebase watches the size of, defined as rules so that
# `flair metrics` records their counts in git notes commit by commit.

# ── Rules ────────────────────────────────────────────────────────────────────────────────────

# Claims of unsafety: the `unsafely` block that supplies the token, every `unsafe`-prefixed
# call (each backed by a `using erased Unsafe` gate, which S1 checks), and the capture-checking
# escape hatches, which bypass a guarantee the same way a gate does but without a token.
rule unsafe
  invokes unsafely
  invokes unsafe*
  annotates unsafeAssumePure
  annotates untrackedCaptures
  message  This bypasses a guarantee the compiler would otherwise enforce

# Casts, which bypass the type checker.
rule cast
  invokes asInstanceOf
  invokes isInstanceOf
  message  Casts bypass the type checker; prefer a pattern match or an extractor

# Nullability: the `null` literal and the `.nn` assertion that unpacks it.
rule nullable
  uses null
  invokes nn
  message  Nullability is confined to the Java boundary

# The imperative constructs the confined-indexing campaign is draining (etc/check-while-count.py).
rule imperative
  uses while
  uses var
  uses return
  invokes readUnchecked

# Exceptions: thrown, or caught wholesale.
rule exceptional
  uses throw
  uses catch-all

# Partial accessors that fail at runtime rather than in the type.
rule partial
  invokes get
  invokes head
  invokes apply

# The model `flair assess` consults, and where its credential comes from: the Pyrocosm cascade
# (`credential anthropic` in ~/.config/pyrocosm/credentials.tel, or ANTHROPIC_API_KEY).
model haiku
  provider   anthropic
  model      claude-haiku-4-5
  credential anthropic
  batch      10
  limit      16384
  mode       batches

# The coercion-helper census (doc/standards/plumbing.md): small definitions that only re-wrap a
# value, judged by the model against the rubric there. `flair assess plumbing` records the
# verdicts under refs/notes/flair-assess/plumbing; nothing here fails.
rule plumbing
  assess def
  model  haiku
  rubric doc/standards/plumbing.md
  criterion S1 +2 single expression
  criterion S2 +3 adapters only
  criterion S3 +3 round trip
  criterion S4 +1 coercion verb
  criterion S5 +2 synonym of an existing operation
  criterion S6 +3 pure forwarder
  criterion S7 +2 one-to-one ladder
  criterion S8 +1 shape-only return type
  criterion S9 +1 one parameter
  criterion S10 +3 conversion given
  criterion X1 -3 handles failure
  criterion X2 -3 computes
  criterion X3 -2 justified by a comment
  criterion X4 -2 codec-family name
  vocabulary .tt .s .show .as[T] .in[Text] .in[Data] .to[List] .to[Map] .stdlib .puncture
  vocabulary .optional safely Enumerable Extractable Conversion→method extension
  vocabulary inline at call site none
  band definite 10
  band likely 5
  band weak 0
  lines 12
  exclude-name read* write* parse* decode* encode* serialize* deserialize* apply unapply
  exclude-body '{ Expr
  no-using
  gate conversion
  gate ladder 2
  gate round-trip
  gate adapter 3
  gate verb 3
  signal local +2
  signal private +1
  signal calls 1 +2
  signal calls 2 +1
  signal calls 4+ -1
  signal duplicate +3
  signal one-liner +1

# ── Profile ──────────────────────────────────────────────────────────────────────────────────

profile default
  source lib/*/src/**/*.scala
  exclude lib/*/src/test/**
  exclude lib/*/src/bench/**
  exclude lib/proscenium/**
  exclude lib/anticipation/src/text/**
  assess plumbing

  # The `-language` features every library compiles with, so flair parses the sources exactly
  # as the build does (capture and separation checking are syntax, too).
  language implicitConversions
  language experimental.modularity
  language experimental.dependent
  language experimental.relaxedLambdaSyntax
  language experimental.genericNumberLiterals
  language experimental.into
  language experimental.erasedDefinitions
  language experimental.packageObjectValues
  language experimental.saferExceptions
  language experimental.strictEqualityPatternMatching
  language experimental.subCases
  language experimental.multiSpreads
  language experimental.captureChecking
  language experimental.into
  language experimental.erasedDefinitions
  language experimental.saferExceptions
  language experimental.strictEqualityPatternMatching
  language experimental.subCases
  language experimental.multiSpreads
  language experimental.captureChecking
  language experimental.separationChecking

  style consequent
    header etc/header.txt
    columns 100
    umbrella soundness
    module-root lib
    interpolator m
    interpolator j
    interpolator x
    interpolator y
    interpolator tel
    gate Unsafe
      prefix unsafe

  # The rules checked on every build; the rest are measured only.
  enforce cast
