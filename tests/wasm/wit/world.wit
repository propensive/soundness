package test:e2e;

// The world the wasm e2e component (tests/wasm/src) is linked against: every WASI
// interface the seven `.wasi` backends import, so one link exercises them all.
world e2e {
  import wasi:cli/environment@0.2.0;
  import wasi:cli/stdin@0.2.0;
  import wasi:cli/stdout@0.2.0;
  import wasi:cli/stderr@0.2.0;
  import wasi:clocks/monotonic-clock@0.2.0;
  import wasi:clocks/wall-clock@0.2.0;
  import wasi:random/random@0.2.0;
  import wasi:filesystem/types@0.2.0;
  import wasi:filesystem/preopens@0.2.0;
  import wasi:io/error@0.2.0;
  import wasi:io/poll@0.2.0;
  import wasi:io/streams@0.2.0;
  import wasi:sockets/network@0.2.0;
  import wasi:sockets/instance-network@0.2.0;
  import wasi:sockets/tcp-create-socket@0.2.0;
  import wasi:sockets/tcp@0.2.0;
  import wasi:http/types@0.2.0;
  import wasi:http/outgoing-handler@0.2.0;

  export wasi:cli/run@0.2.0;
}

// The HTTP service world: a component that answers requests rather than running once and
// exiting, exercising telekinesis' `WasiHttpServer` — the incoming half of the WASI HTTP
// backend, which nothing else links. Its imports are those of `wasi:http/proxy@0.2.0`, so a
// runtime that hosts the proxy world (`wasmtime serve`, a runwasi shim, Spin) can instantiate
// it; filesystem and sockets are deliberately absent, because the proxy world does not offer
// them.
world http {
  import wasi:cli/stdout@0.2.0;
  import wasi:cli/stderr@0.2.0;
  import wasi:clocks/monotonic-clock@0.2.0;
  import wasi:clocks/wall-clock@0.2.0;
  import wasi:random/random@0.2.0;
  import wasi:io/error@0.2.0;
  import wasi:io/poll@0.2.0;
  import wasi:io/streams@0.2.0;
  import wasi:http/types@0.2.0;
  import wasi:http/outgoing-handler@0.2.0;

  export wasi:http/incoming-handler@0.2.0;
}
